<!-- 404.ejs -->
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Page Not Found | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body>
<div style="min-height:100vh;background:var(--gradient-hero);display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;">
  <div>
    <div style="font-family:'Playfair Display',serif;font-size:8rem;font-weight:900;background:linear-gradient(135deg,#c9a84c,#e8c96a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:1rem;">404</div>
    <h1 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--color-ivory);margin-bottom:0.75rem;">Page Not Found</h1>
    <p style="color:rgba(255,255,255,0.4);max-width:400px;margin:0 auto 2.5rem;line-height:1.8;">The page you're looking for doesn't exist or has been moved.</p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
      <a href="/" class="btn btn-gold btn-lg"><i class="fa-solid fa-house"></i> Go Home</a>
      <a href="/scholarships" class="btn btn-outline-gold btn-lg">Browse Scholarships</a>
    </div>
  </div>
</div>
</body></html>
