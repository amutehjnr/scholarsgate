<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= scholarship.name %> | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<%- include('../../partials/header') %>

<!-- Hero -->
<section class="scholarship-hero">
  <div class="container-2xl">
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:4rem;align-items:start;">
      <div>
        <div class="scholarship-badge-row">
          <% const typeColors={full:'success',merit:'info',stem:'info',partial:'warning',boarding:'gold',arts:'gold'}; %>
          <span class="badge badge-<%= typeColors[scholarship.type]||'gray' %>">
            <%= scholarship.type==='full'?'★ Fully Funded':scholarship.type.charAt(0).toUpperCase()+scholarship.type.slice(1)+' Scholarship' %>
          </span>
          <% if(scholarship.featured){%><span class="badge badge-gold"><i class="fa-solid fa-star"></i> Featured</span><%}%>
          <% if(new Date()>new Date(scholarship.applicationDeadline)){%>
            <span class="badge badge-danger">Deadline Passed</span>
          <%} else {%>
            <span class="badge badge-success">Applications Open</span>
          <%}%>
        </div>

        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,3rem);font-weight:900;color:var(--color-ivory);line-height:1.1;margin:0.75rem 0;">
          <%= scholarship.name %>
        </h1>

        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;">
          <div style="width:32px;height:32px;border-radius:6px;background:rgba(201,168,76,0.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-school" style="color:var(--color-gold);font-size:0.875rem;"></i>
          </div>
          <div>
            <span style="font-size:1rem;font-weight:600;color:var(--color-ivory);"><%= scholarship.school?.name %></span>
            <span style="font-size:0.875rem;color:rgba(255,255,255,0.4);margin-left:0.75rem;">
              <i class="fa-solid fa-location-dot" style="margin-right:4px;"></i><%= scholarship.school?.location?.city %>, <%= scholarship.school?.location?.state %>
            </span>
          </div>
        </div>

        <p style="font-size:1rem;color:rgba(255,255,255,0.55);line-height:1.8;max-width:600px;margin-bottom:2rem;">
          <%= scholarship.description %>
        </p>

        <!-- CTA -->
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <% if(user){%>
            <% if(new Date()<=new Date(scholarship.applicationDeadline)){%>
              <a href="/applications/apply/<%= scholarship.slug %>" class="btn btn-gold btn-lg">
                <i class="fa-solid fa-paper-plane"></i> Apply Now
              </a>
            <%}%>
          <%} else {%>
            <a href="/auth/register" class="btn btn-gold btn-lg">
              <i class="fa-solid fa-user-plus"></i> Register to Apply
            </a>
            <a href="/auth/login" class="btn btn-outline-gold btn-lg">Sign In</a>
          <%}%>
          <a href="/schools/<%= scholarship.school?.slug %>" class="btn btn-outline-gold btn-lg">
            <i class="fa-solid fa-school"></i> View School
          </a>
        </div>
      </div>

      <!-- Coverage Card -->
      <div style="background:rgba(255,255,255,0.04);backdrop-filter:blur(20px);border:1px solid rgba(201,168,76,0.2);border-radius:20px;padding:2rem;position:sticky;top:100px;">
        <div style="text-align:center;padding:1.5rem;background:rgba(201,168,76,0.06);border-radius:14px;border:1px solid rgba(201,168,76,0.15);margin-bottom:1.5rem;">
          <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:0.5rem;">Scholarship Coverage</div>
          <div class="coverage-pct"><%= scholarship.coveragePercentage %>%</div>
          <div class="coverage-pct-label">of tuition covered</div>
        </div>

        <div style="display:flex;flex-direction:column;gap:0.875rem;margin-bottom:1.5rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Annual Value</span>
            <span style="font-weight:700;color:var(--color-gold);font-size:1.1rem;">$<%= (scholarship.annualValue||0).toLocaleString() %></span>
          </div>
          <% if(scholarship.remainingTuition){%>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Remaining Tuition</span>
            <span style="font-weight:600;color:var(--color-ivory);">$<%= scholarship.remainingTuition.toLocaleString() %>/yr</span>
          </div>
          <%}%>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Enrollment Deposit</span>
            <span style="font-weight:600;color:var(--color-ivory);">$<%= (scholarship.enrollmentDeposit||500).toLocaleString() %></span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Application Deadline</span>
            <span style="font-weight:600;color:<%= new Date()>new Date(scholarship.applicationDeadline)?'var(--color-danger-light)':'#f5e6b5' %>;">
              <%= new Date(scholarship.applicationDeadline).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %>
            </span>
          </div>
          <% if(scholarship.duration){%>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Duration</span>
            <span style="font-weight:600;color:var(--color-ivory);"><%= scholarship.duration.years %> Years<%= scholarship.duration.renewable?' · Renewable':'' %></span>
          </div>
          <%}%>
          <% if(scholarship.slotsTotal){%>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 0;">
            <span style="font-size:0.75rem;color:rgba(255,255,255,0.35);letter-spacing:0.05em;text-transform:uppercase;">Slots Available</span>
            <span style="font-weight:600;color:var(--color-ivory);"><%= Math.max(0,scholarship.slotsTotal-scholarship.slotsFilled) %> / <%= scholarship.slotsTotal %></span>
          </div>
          <%}%>
        </div>

        <% if(user && new Date()<=new Date(scholarship.applicationDeadline)){%>
          <a href="/applications/apply/<%= scholarship.slug %>" class="btn btn-gold w-full btn-lg" style="justify-content:center;">
            Apply Now <i class="fa-solid fa-arrow-right" style="margin-left:4px;"></i>
          </a>
        <%} else if(!user){%>
          <a href="/auth/register" class="btn btn-gold w-full btn-lg" style="justify-content:center;">
            Register to Apply
          </a>
        <%}%>
      </div>
    </div>
  </div>
</section>

<!-- Details -->
<section class="section-lg" style="background:var(--color-cream);">
  <div class="container-2xl">
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:4rem;">
      <div style="display:flex;flex-direction:column;gap:2rem;">

        <!-- Benefits -->
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;">
            <i class="fa-solid fa-gift" style="color:var(--color-gold);margin-right:0.75rem;"></i>Scholarship Benefits
          </h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">
            <% const benefitMap=[
              {key:'fullTuition',label:'Full Tuition Support'},
              {key:'tuition',label:'Tuition Assistance'},
              {key:'boarding',label:'Boarding Accommodation'},
              {key:'meals',label:'Meals Included'},
              {key:'books',label:'Books & Materials'},
              {key:'uniform',label:'Uniform Provided'},
              {key:'healthInsurance',label:'Health Insurance'},
              {key:'airfare',label:'Airfare Allowance'},
              {key:'satPrep',label:'SAT/ACT Preparation'},
              {key:'mentorship',label:'Professional Mentorship'},
              {key:'internship',label:'Internship Access'},
              {key:'collegeGuidance',label:'College Guidance'},
              {key:'leadershipPrograms',label:'Leadership Programs'},
              {key:'stemMentorship',label:'STEM Mentorship'},
              {key:'academicCounseling',label:'Academic Counseling'},
            ]; %>
            <% benefitMap.forEach(b=>{ if(scholarship.benefits?.[b.key]){ %>
            <div class="benefit-item">
              <div class="benefit-check">✓</div>
              <span style="font-size:0.875rem;font-weight:500;color:var(--color-text-primary);"><%= b.label %></span>
            </div>
            <%}}); %>
            <% (scholarship.benefits?.custom||[]).forEach(c=>{ %>
            <div class="benefit-item">
              <div class="benefit-check">✓</div>
              <span style="font-size:0.875rem;font-weight:500;"><%= c %></span>
            </div>
            <%}); %>
          </div>
        </div>

        <!-- Eligibility -->
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;">
            <i class="fa-solid fa-clipboard-check" style="color:var(--color-gold);margin-right:0.75rem;"></i>Eligibility Requirements
          </h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
            <% if(scholarship.eligibility?.grades?.length){%>
            <div style="padding:1rem;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Eligible Grades</div>
              <div style="font-weight:600;">Grade <%= scholarship.eligibility.grades.join(', ') %></div>
            </div>
            <%}%>
            <% if(scholarship.eligibility?.minGpa){%>
            <div style="padding:1rem;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Minimum GPA</div>
              <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--color-gold-dim);"><%= scholarship.eligibility.minGpa %> <span style="font-size:1rem;color:var(--color-text-muted);">/ 4.0</span></div>
            </div>
            <%}%>
            <% if(scholarship.eligibility?.ageMin || scholarship.eligibility?.ageMax){%>
            <div style="padding:1rem;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Age Range</div>
              <div style="font-weight:600;"><%= scholarship.eligibility.ageMin||'—' %> – <%= scholarship.eligibility.ageMax||'—' %> years</div>
            </div>
            <%}%>
            <% if(scholarship.eligibility?.nationalities?.length){%>
            <div style="padding:1rem;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Open To</div>
              <div style="font-weight:600;font-size:0.875rem;"><%= scholarship.eligibility.nationalities.join(', ') || 'International Students' %></div>
            </div>
            <%}%>
          </div>
          <% if(scholarship.eligibility?.other?.length){%>
          <div style="margin-top:1.25rem;">
            <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.75rem;">Additional Requirements</div>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:0.5rem;">
              <% scholarship.eligibility.other.forEach(req=>{ %>
              <li style="display:flex;align-items:flex-start;gap:0.75rem;font-size:0.875rem;color:var(--color-text-secondary);">
                <i class="fa-solid fa-circle-dot" style="color:var(--color-gold);margin-top:4px;font-size:0.5rem;flex-shrink:0;"></i>
                <%= req %>
              </li>
              <%}); %>
            </ul>
          </div>
          <%}%>
        </div>

        <!-- Application Requirements -->
        <% if(scholarship.applicationRequirements?.length){%>
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;">
            <i class="fa-solid fa-folder-open" style="color:var(--color-gold);margin-right:0.75rem;"></i>Required Documents
          </h2>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <% scholarship.applicationRequirements.forEach((req,i)=>{ %>
            <div style="display:flex;align-items:center;gap:1rem;padding:0.875rem 1rem;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);">
              <div style="width:28px;height:28px;border-radius:50%;background:rgba(201,168,76,0.1);display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;color:var(--color-gold-dim);flex-shrink:0;"><%= i+1 %></div>
              <span style="font-size:0.875rem;color:var(--color-text-secondary);"><%= req %></span>
            </div>
            <%}); %>
          </div>
        </div>
        <%}%>
      </div>

      <!-- Right Sidebar -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- School Card -->
        <a href="/schools/<%= scholarship.school?.slug %>" style="background:#fff;border-radius:20px;overflow:hidden;box-shadow:var(--shadow-sm);border:var(--border-dark);text-decoration:none;display:block;transition:all 0.3s;" onmouseover="this.style.boxShadow='var(--shadow-lg)';this.style.transform='translateY(-3px)'" onmouseout="this.style.boxShadow='var(--shadow-sm)';this.style.transform=''">
          <div style="background:var(--gradient-navy);padding:1.5rem;border-bottom:1px solid rgba(201,168,76,0.1);">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:0.5rem;">Partner School</div>
            <div style="font-family:'Playfair Display',serif;font-size:1.15rem;font-weight:700;color:var(--color-ivory);"><%= scholarship.school?.name %></div>
            <div style="font-size:0.8rem;color:rgba(255,255,255,0.4);margin-top:4px;"><i class="fa-solid fa-location-dot" style="margin-right:4px;"></i><%= scholarship.school?.location?.city %>, <%= scholarship.school?.location?.state %></div>
          </div>
          <div style="padding:1.25rem;">
            <p style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.7;margin-bottom:0.75rem;"><%= scholarship.school?.overview?.substring(0,150) %>...</p>
            <div style="display:flex;align-items:center;gap:0.5rem;color:var(--color-gold-dim);font-size:0.8rem;font-weight:600;">View School Profile <i class="fa-solid fa-arrow-right"></i></div>
          </div>
        </a>

        <!-- Related Scholarships -->
        <% if(relatedScholarships?.length){%>
        <div style="background:#fff;border-radius:20px;padding:1.5rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;margin-bottom:1.25rem;">Related Scholarships</h3>
          <div style="display:flex;flex-direction:column;gap:0.875rem;">
            <% relatedScholarships.forEach(rs=>{ %>
            <a href="/scholarships/<%= rs.slug %>" style="display:flex;align-items:center;gap:0.875rem;padding:0.875rem;border:var(--border-dark);border-radius:12px;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.3)';this.style.background='rgba(201,168,76,0.02)'" onmouseout="this.style.borderColor='';this.style.background=''">
              <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#c9a84c,#e8c96a);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:1rem;font-weight:700;color:#0a0e1a;flex-shrink:0;"><%= rs.coveragePercentage %>%</div>
              <div>
                <div style="font-weight:600;font-size:0.8rem;color:var(--color-text-primary);line-height:1.3;"><%= rs.name %></div>
                <div style="font-size:0.7rem;color:var(--color-text-muted);margin-top:2px;">$<%= (rs.annualValue||0).toLocaleString() %>/yr</div>
              </div>
            </a>
            <%}); %>
          </div>
        </div>
        <%}%>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}</style>
<script src="/js/main.js"></script>
</body>
</html>
