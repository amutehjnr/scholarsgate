<!-- contact.ejs -->
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Contact Us | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body>
<%- include('../../partials/header') %>
<section style="background:var(--gradient-hero);padding:9rem 0 5rem;">
  <div class="container" style="text-align:center;">
    <span class="section-label">Get In Touch</span>
    <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2rem,4vw,3.5rem);font-weight:900;color:var(--color-ivory);margin:0.75rem 0;">We're Here to Help</h1>
    <p style="color:rgba(255,255,255,0.45);max-width:460px;margin:0 auto;">Have questions about scholarships or admissions? Our team is ready to guide you.</p>
  </div>
</section>
<section class="section-xl" style="background:var(--color-cream);">
  <div class="container-md" style="max-width:800px;">
    <div style="display:grid;grid-template-columns:1fr 1.5fr;gap:3rem;">
      <div>
        <h3 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:1.5rem;">Contact Information</h3>
        <% const contacts=[
          {icon:'fa-envelope',label:'Email',value:'support@scholarsgate.com',href:'mailto:support@scholarsgate.com'},
          {icon:'fa-phone',label:'Phone',value:'+1 (212) 555-0100',href:'tel:+12125550100'},
          {icon:'fa-clock',label:'Hours',value:'Mon–Fri: 9AM – 6PM EST'},
          {icon:'fa-location-dot',label:'Address',value:'New York, NY, USA'},
        ]; %>
        <% contacts.forEach(c=>{%>
        <div style="display:flex;align-items:flex-start;gap:1rem;margin-bottom:1.5rem;">
          <div style="width:40px;height:40px;border-radius:10px;background:rgba(201,168,76,0.1);display:flex;align-items:center;justify-content:center;color:var(--color-gold-dim);flex-shrink:0;"><i class="fa-solid <%= c.icon %>"></i></div>
          <div><div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;"><%= c.label %></div>
          <% if(c.href){%><a href="<%= c.href %>" style="font-weight:600;color:var(--color-text-primary);text-decoration:none;"><%= c.value %></a><%}else{%><div style="font-weight:600;"><%= c.value %></div><%}%></div>
        </div>
        <%})%>
      </div>
      <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
        <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;margin-bottom:1.5rem;">Send a Message</h3>
        <form style="display:flex;flex-direction:column;gap:1rem;">
          <div class="form-group"><label class="form-label">Your Name</label><input type="text" class="form-control" placeholder="Jane Smith" required/></div>
          <div class="form-group"><label class="form-label">Email</label><input type="email" class="form-control" placeholder="jane@email.com" required/></div>
          <div class="form-group"><label class="form-label">Subject</label><select class="form-control form-select"><option>Scholarship Inquiry</option><option>Application Support</option><option>Technical Issue</option><option>Partnership</option><option>Other</option></select></div>
          <div class="form-group"><label class="form-label">Message</label><textarea class="form-control form-textarea" placeholder="How can we help you?" rows="4" required></textarea></div>
          <button type="button" class="btn btn-gold btn-lg" onclick="showToast('Message sent! We will respond within 24 hours.','success')"><i class="fa-solid fa-paper-plane"></i> Send Message</button>
        </form>
      </div>
    </div>
  </div>
</section>
<%- include('../../partials/footer') %>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}.toast-success{border-left:3px solid #2a8a3a;}.toast-success .toast-icon{background:#e8f5ea;color:#1a6b2a;}</style>
<script src="/js/main.js"></script>
</body></html>
