<!-- school-detail.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title><%= school.name %> | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<%- include('../../partials/header') %>

<!-- School Hero -->
<section style="background:var(--gradient-hero);padding:9rem 0 5rem;border-bottom:1px solid rgba(201,168,76,0.1);position:relative;overflow:hidden;">
  <% if(school.images?.hero){%>
  <div style="position:absolute;inset:0;"><img src="<%= school.images.hero %>" alt="<%= school.name %>" style="width:100%;height:100%;object-fit:cover;opacity:0.1;"/></div>
  <%}%>
  <div class="container-2xl" style="position:relative;z-index:1;">
    <div style="display:flex;align-items:flex-start;gap:2rem;">
      <div style="width:80px;height:80px;border-radius:16px;background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;">
        <% if(school.images?.logo){%><img src="<%= school.images.logo %>" alt="Logo" style="width:100%;height:100%;object-fit:contain;padding:8px;"/>
        <%} else {%><i class="fa-solid fa-school" style="font-size:2rem;color:var(--color-gold);opacity:0.7;"></i><%}%>
      </div>
      <div>
        <div style="display:flex;gap:0.75rem;margin-bottom:0.75rem;flex-wrap:wrap;">
          <span class="badge badge-gold" style="text-transform:capitalize;"><%= school.type %></span>
          <span class="badge badge-gold" style="text-transform:capitalize;"><%= school.category %></span>
          <% if(school.featured){%><span class="badge badge-gold"><i class="fa-solid fa-star"></i> Featured</span><%}%>
        </div>
        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,3rem);font-weight:900;color:var(--color-ivory);margin:0 0 0.5rem;"><%= school.name %></h1>
        <p style="color:rgba(255,255,255,0.45);font-size:1rem;"><i class="fa-solid fa-location-dot" style="margin-right:6px;"></i><%= school.location?.city %>, <%= school.location?.state %>, USA</p>
      </div>
    </div>
    <!-- Quick stats -->
    <div style="display:flex;gap:2.5rem;margin-top:2.5rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,0.08);flex-wrap:wrap;">
      <% const quickStats=[
        {label:'Founded',value:school.founded?`Est. ${school.founded}`:'N/A'},
        {label:'Students',value:school.stats?.totalStudents?(school.stats.totalStudents.toLocaleString()):'N/A'},
        {label:'Student:Teacher',value:school.stats?.studentTeacherRatio||'N/A'},
        {label:'Annual Tuition',value:school.tuition?.annual?`$${Math.round(school.tuition.annual/1000)}K`:'N/A'},
        {label:'College Acceptance',value:school.stats?.collegeAcceptanceRate?`${school.stats.collegeAcceptanceRate}%`:'N/A'},
        {label:'Avg SAT',value:school.stats?.satAverage?school.stats.satAverage.toLocaleString():'N/A'},
      ]; %>
      <% quickStats.forEach(s=>{%>
      <div>
        <div style="font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:700;color:var(--color-gold);"><%= s.value %></div>
        <div style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);"><%= s.label %></div>
      </div>
      <%})%>
    </div>
  </div>
</section>

<!-- Content -->
<section class="section-lg" style="background:var(--color-cream);">
  <div class="container-2xl">
    <div style="display:grid;grid-template-columns:2fr 1fr;gap:3rem;">
      <div style="display:flex;flex-direction:column;gap:2rem;">
        <!-- Overview -->
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:1.25rem;">About <%= school.name %></h2>
          <p style="color:var(--color-text-secondary);line-height:1.9;"><%= school.overview %></p>
          <% if(school.mission){%><p style="color:var(--color-text-secondary);line-height:1.9;margin-top:1rem;font-style:italic;padding-left:1rem;border-left:3px solid var(--color-gold);"><%= school.mission %></p><%}%>
        </div>

        <!-- Programs -->
        <% if(school.programs?.length){%>
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:1.25rem;"><i class="fa-solid fa-book-open" style="color:var(--color-gold);margin-right:0.75rem;"></i>Academic Programs</h2>
          <div style="display:flex;flex-wrap:wrap;gap:0.625rem;">
            <% school.programs.forEach(p=>{%><span class="badge badge-navy" style="font-size:0.8rem;padding:0.4rem 1rem;text-transform:none;font-weight:500;letter-spacing:0;"><%= p %></span><%})%>
          </div>
        </div>
        <%}%>

        <!-- Facilities -->
        <% if(school.facilities?.length){%>
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:1.25rem;"><i class="fa-solid fa-building" style="color:var(--color-gold);margin-right:0.75rem;"></i>Campus Facilities</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.625rem;">
            <% school.facilities.forEach(f=>{%>
            <div style="display:flex;align-items:center;gap:0.75rem;padding:0.625rem;background:rgba(0,0,0,0.02);border-radius:8px;">
              <i class="fa-solid fa-check-circle" style="color:var(--color-success-light);font-size:0.875rem;"></i>
              <span style="font-size:0.875rem;color:var(--color-text-secondary);"><%= f %></span>
            </div>
            <%})%>
          </div>
        </div>
        <%}%>

        <!-- Scholarships at this school -->
        <% if(scholarships?.length){%>
        <div style="background:#fff;border-radius:20px;padding:2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h2 style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:1.5rem;"><i class="fa-solid fa-star" style="color:var(--color-gold);margin-right:0.75rem;"></i>Available Scholarships</h2>
          <div style="display:flex;flex-direction:column;gap:1rem;">
            <% scholarships.forEach(s=>{%>
            <a href="/scholarships/<%= s.slug %>" style="display:flex;align-items:center;gap:1.25rem;padding:1.25rem;border:1px solid rgba(201,168,76,0.15);border-radius:14px;text-decoration:none;background:rgba(201,168,76,0.02);transition:all 0.3s;" onmouseover="this.style.borderColor='rgba(201,168,76,0.4)';this.style.background='rgba(201,168,76,0.05)'" onmouseout="this.style.borderColor='rgba(201,168,76,0.15)';this.style.background='rgba(201,168,76,0.02)'">
              <div style="width:60px;height:60px;border-radius:12px;background:linear-gradient(135deg,#c9a84c,#e8c96a);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;">
                <span style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#0a0e1a;line-height:1;"><%= s.coveragePercentage %>%</span>
                <span style="font-size:8px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0a0e1a;opacity:0.6;">Covered</span>
              </div>
              <div style="flex:1;">
                <div style="font-weight:700;color:var(--color-text-primary);margin-bottom:4px;"><%= s.name %></div>
                <div style="font-size:0.8rem;color:var(--color-text-muted);">$<%= (s.annualValue||0).toLocaleString() %>/year · Deadline: <%= new Date(s.applicationDeadline).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></div>
              </div>
              <span class="badge badge-<%= s.type==='full'?'success':'info' %>" style="flex-shrink:0;"><%= s.type %></span>
            </a>
            <%})%>
          </div>
        </div>
        <%}%>
      </div>

      <!-- Right Sidebar -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">
        <!-- Contact -->
        <div style="background:#fff;border-radius:20px;padding:1.5rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.25rem;">Contact Information</h3>
          <div style="display:flex;flex-direction:column;gap:0.875rem;">
            <% if(school.contactInfo?.email){%>
            <a href="mailto:<%= school.contactInfo.email %>" style="display:flex;align-items:center;gap:0.75rem;font-size:0.875rem;color:var(--color-text-secondary);text-decoration:none;">
              <i class="fa-solid fa-envelope" style="color:var(--color-gold);width:16px;"></i><%= school.contactInfo.email %>
            </a>
            <%}%>
            <% if(school.contactInfo?.phone){%>
            <div style="display:flex;align-items:center;gap:0.75rem;font-size:0.875rem;color:var(--color-text-secondary);">
              <i class="fa-solid fa-phone" style="color:var(--color-gold);width:16px;"></i><%= school.contactInfo.phone %>
            </div>
            <%}%>
            <% if(school.contactInfo?.website){%>
            <a href="<%= school.contactInfo.website %>" target="_blank" style="display:flex;align-items:center;gap:0.75rem;font-size:0.875rem;color:var(--color-gold-dim);text-decoration:none;">
              <i class="fa-solid fa-globe" style="color:var(--color-gold);width:16px;"></i>Official Website ↗
            </a>
            <%}%>
          </div>
        </div>
        <!-- Accreditation -->
        <% if(school.accreditation?.length){%>
        <div style="background:#fff;border-radius:20px;padding:1.5rem;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1rem;">Accreditation</h3>
          <% school.accreditation.forEach(a=>{%>
          <div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem 0;border-bottom:1px solid rgba(0,0,0,0.04);">
            <i class="fa-solid fa-certificate" style="color:var(--color-gold);font-size:0.875rem;"></i>
            <span style="font-size:0.875rem;font-weight:600;"><%= a %></span>
          </div>
          <%})%>
        </div>
        <%}%>
        <!-- Apply CTA -->
        <div style="background:var(--gradient-navy);border-radius:20px;padding:1.75rem;border:1px solid rgba(201,168,76,0.15);text-align:center;">
          <div style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--color-ivory);margin-bottom:0.5rem;">Ready to Apply?</div>
          <p style="font-size:0.8rem;color:rgba(255,255,255,0.45);margin-bottom:1.25rem;line-height:1.6;">Browse available scholarships and start your application today.</p>
          <% if(scholarships?.length){%>
          <a href="/scholarships/<%= scholarships[0].slug %>" class="btn btn-gold w-full" style="justify-content:center;">Apply for Scholarship</a>
          <%} else if(user){%>
          <a href="/parent/dashboard" class="btn btn-gold w-full" style="justify-content:center;">Go to Dashboard</a>
          <%} else {%>
          <a href="/auth/register" class="btn btn-gold w-full" style="justify-content:center;">Get Started Free</a>
          <%}%>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;}</style>
<script src="/js/main.js"></script>
</body>
</html>
