<!-- apply.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Apply — <%= scholarship.name %> | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<%- include('../../partials/header') %>
<div style="padding-top:var(--header-height);background:var(--gradient-hero);min-height:100vh;">
  <div class="container-md" style="max-width:760px;padding:3rem 1.5rem;">

    <!-- Header -->
    <div style="text-align:center;margin-bottom:2.5rem;">
      <span class="section-label">Scholarship Application</span>
      <h1 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--color-ivory);margin:0.5rem 0;"><%= scholarship.name %></h1>
      <p style="color:rgba(255,255,255,0.45);"><%= scholarship.school?.name %> · <%= scholarship.coveragePercentage %>% Coverage · $<%= (scholarship.annualValue||0).toLocaleString() %>/yr</p>
    </div>

    <!-- Flash -->
    <%- include('../../partials/flash') %>

    <!-- Form -->
    <div style="background:rgba(255,255,255,0.04);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:2.5rem;box-shadow:0 32px 80px rgba(0,0,0,0.4);">
      <form action="/applications/apply/<%= scholarship.slug %>" method="POST" enctype="multipart/form-data" data-validate class="form-dark">

        <!-- Student Selection -->
        <div class="form-group">
          <label class="form-label">Select Student <span class="required">*</span></label>
          <select name="studentId" class="form-control form-select" required>
            <option value="">Choose a student profile...</option>
            <% students.forEach(s=>{%>
            <option value="<%= s._id %>"><%= s.firstName %> <%= s.lastName %> — Grade <%= s.intendedGrade %> · GPA: <%= s.gpa||'N/A' %></option>
            <%})%>
          </select>
          <p class="form-hint" style="color:rgba(255,255,255,0.3);">
            Need to add a student? <a href="/parent/students/add" style="color:var(--color-gold);">Create profile first</a>
          </p>
        </div>

        <div style="height:1px;background:rgba(255,255,255,0.06);margin:1.5rem 0;"></div>

        <!-- Why This School -->
        <div class="form-group">
          <label class="form-label">Why This School? <span class="required">*</span></label>
          <textarea name="whyThisSchool" class="form-control form-textarea" placeholder="Explain why your child wants to attend this specific school (200–500 words)..." rows="5" required minlength="100" maxlength="2000"></textarea>
          <p class="form-hint" style="color:rgba(255,255,255,0.3);">100–2,000 characters</p>
        </div>

        <!-- Personal Statement -->
        <div class="form-group">
          <label class="form-label">Personal Statement</label>
          <textarea name="personalStatement" class="form-control form-textarea" placeholder="Describe your child's academic achievements, goals, and aspirations..." rows="6" maxlength="5000"></textarea>
          <p class="form-hint" style="color:rgba(255,255,255,0.3);">Up to 5,000 characters</p>
        </div>

        <!-- Extracurriculars -->
        <div class="form-group">
          <label class="form-label">Extracurricular Activities</label>
          <textarea name="extracurriculars" class="form-control form-textarea" placeholder="List key activities, clubs, sports, volunteer work..." rows="3"></textarea>
        </div>

        <!-- Scholarship Info Summary -->
        <div style="padding:1.25rem;background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.15);border-radius:14px;margin-bottom:1.5rem;">
          <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-gold);margin-bottom:0.875rem;">Application Summary</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
            <div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.3);">Scholarship</div><div style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);"><%= scholarship.name %></div></div>
            <div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.3);">Coverage</div><div style="font-size:0.875rem;font-weight:600;color:var(--color-gold);"><%= scholarship.coveragePercentage %>%</div></div>
            <div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.3);">Annual Value</div><div style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);">$<%= (scholarship.annualValue||0).toLocaleString() %></div></div>
            <div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.3);">Deadline</div><div style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);"><%= new Date(scholarship.applicationDeadline).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></div></div>
            <div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.3);">Application Fee</div><div style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);"><%= scholarship.applicationFee ? '$' + scholarship.applicationFee.toLocaleString() : 'Free' %></div></div>
          </div>
          <% if (scholarship.applicationFee) { %>
          <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin-top:0.875rem;margin-bottom:0;">
            <i class="fa-solid fa-circle-info" style="margin-right:4px;"></i>
            A $<%= scholarship.applicationFee.toLocaleString() %> application fee is required to submit this application. Pay it below — your application will be reviewed once the fee is verified.
          </p>
          <% } %>
        </div>

        <!-- Application Fee Payment — only when this scholarship charges one -->
        <% if (scholarship.applicationFee) { %>
        <div style="height:1px;background:rgba(255,255,255,0.06);margin:1.5rem 0;"></div>

        <div style="margin-bottom:1.5rem;">
          <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-gold);margin-bottom:1rem;">
            Application Fee — $<%= scholarship.applicationFee.toLocaleString() %>
          </div>

          <!-- Hidden crypto fields (populated by JS) -->
          <input type="hidden" name="cryptoTxHash" id="hiddenTxHash"/>
          <input type="hidden" name="cryptoWalletAddress" id="hiddenWalletAddress"/>
          <input type="hidden" name="cryptoNetwork" id="hiddenNetwork"/>

          <!-- Bank transfer — disabled for now, crypto-only -->
          <!--
          <% if (bankDetails) { %>
          <div style="padding:1rem 1.25rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:14px;margin-bottom:1.25rem;">
            <div style="display:flex;flex-direction:column;gap:0.5rem;font-size:0.8rem;">
              <% if (bankDetails.bankName) { %><div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">Bank Name</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.bankName %></span></div><% } %>
              <div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">Account Name</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.accountName %></span></div>
              <div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">Account Number</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.accountNumber %></span></div>
              <% if (bankDetails.routingNumber) { %><div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">Routing (ABA)</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.routingNumber %></span></div><% } %>
              <% if (bankDetails.swiftCode) { %><div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">SWIFT / BIC</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.swiftCode %></span></div><% } %>
              <% if (bankDetails.iban) { %><div style="display:flex;justify-content:space-between;"><span style="color:rgba(255,255,255,0.4);">IBAN</span><span style="color:var(--color-ivory);font-weight:600;"><%= bankDetails.iban %></span></div><% } %>
            </div>
          </div>
          <% } %>
          -->

          <!-- Crypto network selector -->
          <% if (bankDetails?.cryptoEnabled) { %>
          <div style="margin-bottom:1.25rem;">
            <label class="form-label">Select Cryptocurrency & Network <span class="required">*</span></label>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:0.625rem;" id="cryptoNetworkGrid">
              <% const cryptoOptions = [
                { id:'usdt-trc20', label:'USDT', sub:'TRC20 (TRON)', address: bankDetails.cryptoAddresses?.usdtTrc20, icon:'💵', color:'#26a17b' },
                { id:'usdt-erc20', label:'USDT', sub:'ERC20 (Ethereum)', address: bankDetails.cryptoAddresses?.usdtErc20, icon:'💵', color:'#26a17b' },
                { id:'usdt-bep20', label:'USDT', sub:'BEP20 (BNB Chain)', address: bankDetails.cryptoAddresses?.usdtBep20, icon:'💵', color:'#F0B90B' },
                { id:'btc',        label:'Bitcoin', sub:'BTC Mainnet', address: bankDetails.cryptoAddresses?.bitcoin, icon:'₿', color:'#f7931a' },
                { id:'eth',        label:'Ethereum', sub:'ETH Mainnet', address: bankDetails.cryptoAddresses?.ethereum, icon:'Ξ', color:'#627eea' },
              ]; %>
              <% cryptoOptions.forEach(opt => { if (opt.address) { %>
              <label style="display:flex;flex-direction:column;align-items:center;gap:0.375rem;padding:0.875rem 0.625rem;border-radius:10px;border:2px solid rgba(255,255,255,0.1);cursor:pointer;text-align:center;transition:all 0.2s;background:rgba(255,255,255,0.02);"
                class="crypto-option-label" data-address="<%= opt.address %>" data-id="<%= opt.id %>"
                onclick="selectCrypto(this,'<%= opt.address %>','<%= opt.id %>')">
                <input type="radio" name="_cryptoChoice" value="<%= opt.id %>" style="display:none;"/>
                <span style="font-size:1.3rem;"><%= opt.icon %></span>
                <span style="font-size:0.8rem;font-weight:700;color:var(--color-ivory);"><%= opt.label %></span>
                <span style="font-size:0.6rem;color:rgba(255,255,255,0.35);"><%= opt.sub %></span>
              </label>
              <% } }); %>
            </div>
          </div>

          <!-- Wallet address display (shown after selection) -->
          <div id="cryptoAddressDisplay" style="display:none;background:linear-gradient(135deg,#0f1524,#1a2240);border-radius:14px;padding:1.25rem;border:1px solid rgba(201,168,76,0.25);margin-bottom:1.25rem;">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:0.75rem;">Send Payment To This Wallet</div>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <div id="cryptoAddressText" style="font-family:monospace;font-size:0.8rem;color:var(--color-gold);word-break:break-all;flex:1;background:rgba(201,168,76,0.08);padding:0.75rem;border-radius:8px;border:1px solid rgba(201,168,76,0.2);"></div>
              <button type="button" onclick="copyWallet()" title="Copy address"
                style="width:38px;height:38px;border-radius:8px;background:rgba(201,168,76,0.1);border:1px solid rgba(201,168,76,0.3);color:var(--color-gold);cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                <i class="fa-regular fa-copy"></i>
              </button>
            </div>
            <div style="margin-top:0.875rem;padding:0.75rem;background:rgba(255,165,0,0.08);border-radius:8px;border:1px solid rgba(255,165,0,0.2);">
              <p style="font-size:0.75rem;color:rgba(255,200,100,0.8);line-height:1.7;margin:0;">
                <i class="fa-solid fa-triangle-exclamation" style="margin-right:6px;"></i>
                Send <strong style="color:var(--color-gold);">exactly $<%= scholarship.applicationFee.toLocaleString() %> USD</strong> equivalent. Double-check the network before sending — wrong network = lost funds.
              </p>
            </div>
            <% if (bankDetails.cryptoInstructions) { %>
            <p style="font-size:0.75rem;color:rgba(255,255,255,0.4);line-height:1.7;margin-top:0.75rem;"><%= bankDetails.cryptoInstructions %></p>
            <% } %>
          </div>
          <% } else { %>
          <div style="padding:1rem 1.25rem;background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.15);border-radius:14px;margin-bottom:1.25rem;font-size:0.8rem;color:rgba(255,255,255,0.5);">
            <i class="fa-solid fa-triangle-exclamation" style="color:var(--color-warning);margin-right:6px;"></i>
            Payment isn't configured yet. Contact <a href="mailto:payments@scholarsgate.com" style="color:var(--color-gold);">payments@scholarsgate.com</a> before applying.
          </div>
          <% } %>

          <div class="form-group">
            <label class="form-label">Payment Method <span class="required">*</span></label>
            <select name="paymentMethod" class="form-control form-select" required id="paymentMethodSelect" onchange="handleMethodChange(this.value)">
              <option value="">Select method...</option>
              <% if (bankDetails?.cryptoEnabled) { %>
              <optgroup label="Cryptocurrency">
                <option value="crypto_usdt">USDT (TRC20 / ERC20 / BEP20)</option>
                <option value="crypto_btc">Bitcoin (BTC)</option>
                <option value="crypto_eth">Ethereum (ETH)</option>
              </optgroup>
              <% } %>
              <option value="other">Other</option>
            </select>
          </div>

          <!-- Crypto-specific fields -->
          <div id="cryptoExtraFields" style="display:none;">
            <div class="form-group">
              <label class="form-label">Transaction Hash (TX ID) <span class="required">*</span></label>
              <input type="text" id="txHashInput" class="form-control" style="font-family:monospace;font-size:0.85rem;"
                placeholder="0x... or full transaction hash from your wallet"
                oninput="document.getElementById('hiddenTxHash').value=this.value"/>
              <p class="form-hint" style="color:rgba(255,255,255,0.3);">Find this in your wallet app under transaction history. It proves the payment was sent on-chain.</p>
            </div>
            <div class="form-group">
              <label class="form-label">Your Sending Wallet Address</label>
              <input type="text" id="senderWalletInput" class="form-control" style="font-family:monospace;font-size:0.85rem;"
                placeholder="Your wallet address (optional but helps verification)"
                oninput="document.getElementById('hiddenWalletAddress').value=this.value"/>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Transaction Reference Number</label>
            <input type="text" name="referenceNumber" class="form-control" placeholder="e.g. TXN-2024-XXXXXXXX"/>
          </div>

          <div class="form-group">
            <label class="form-label">Payment Proof <span class="required">*</span></label>
            <div class="upload-zone" style="position:relative;">
              <input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png" required
                style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;"/>
              <div class="upload-prompt">
                <span class="upload-icon" style="font-size:2.5rem;">📎</span>
                <div style="font-weight:600;color:var(--color-ivory);margin-bottom:0.25rem;">Click or drag file here</div>
                <div style="font-size:0.8rem;color:rgba(255,255,255,0.35);">PDF, JPG, or PNG · Max 10MB</div>
              </div>
              <div class="upload-success" style="display:none;">
                <span style="font-size:2rem;">✅</span>
                <div style="font-weight:600;color:var(--color-success-light);">File selected</div>
                <div class="upload-file-name" style="font-size:0.8rem;color:rgba(255,255,255,0.35);"></div>
              </div>
            </div>
            <p class="form-hint" style="color:rgba(255,255,255,0.3);">Screenshot or confirmation of the crypto transfer above.</p>
          </div>
        </div>
        <% } %>

        <!-- Agreement -->
        <div style="margin-bottom:1.5rem;">
          <label style="display:flex;align-items:flex-start;gap:0.75rem;cursor:pointer;">
            <input type="checkbox" required style="margin-top:3px;accent-color:var(--color-gold);"/>
            <span style="font-size:0.8rem;color:rgba(255,255,255,0.4);line-height:1.6;">
              I confirm that all information provided is accurate and complete. I understand that false statements may result in disqualification.
            </span>
          </label>
        </div>

        <div style="display:flex;gap:1rem;">
          <a href="/scholarships/<%= scholarship.slug %>" class="btn btn-ghost" style="color:rgba(255,255,255,0.5);border-color:rgba(255,255,255,0.1);">Cancel</a>
          <button type="submit" class="btn btn-gold btn-lg" style="flex:1;justify-content:center;">
            <i class="fa-solid fa-paper-plane"></i> <%= scholarship.applicationFee ? 'Submit Application & Pay Fee' : 'Submit Application' %>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../../partials/footer') %>
<style>
  .crypto-option-label { transition: all 0.2s; }
  .crypto-option-label.selected { border-color: var(--color-gold) !important; background: rgba(201,168,76,0.08) !important; }
</style>
<script src="/js/main.js"></script>
<% if (scholarship.applicationFee) { %>
<script>
// ── Crypto network card selection ───────────────────────────────────────────
function selectCrypto(el, address, networkId) {
  document.querySelectorAll('.crypto-option-label').forEach(l => l.classList.remove('selected'));
  el.classList.add('selected');
  el.querySelector('input[type=radio]').checked = true;

  const display = document.getElementById('cryptoAddressDisplay');
  document.getElementById('cryptoAddressText').textContent = address;
  document.getElementById('hiddenNetwork').value = networkId;
  display.style.display = 'block';
}

function copyWallet() {
  const addr = document.getElementById('cryptoAddressText').textContent;
  navigator.clipboard.writeText(addr).then(() => {
    if (typeof showToast === 'function') showToast('Wallet address copied!', 'success');
  });
}

// ── Payment method select handler ───────────────────────────────────────────
function handleMethodChange(val) {
  const isCrypto = val.startsWith('crypto_');
  document.getElementById('cryptoExtraFields').style.display = isCrypto ? 'block' : 'none';
  const txInput = document.getElementById('txHashInput');
  if (txInput) txInput.required = isCrypto;
}
</script>
<% } %>
</body>
</html>
