<!-- error.ejs -->
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Error | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body>
<div style="min-height:100vh;background:var(--gradient-hero);display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;">
  <div>
    <div style="font-size:4rem;margin-bottom:1.5rem;opacity:0.4;"><i class="fa-solid fa-triangle-exclamation" style="color:#c9a84c;"></i></div>
    <h1 style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--color-ivory);margin-bottom:0.75rem;"><%= statusCode || 500 %> — <%= message || 'Something went wrong' %></h1>
    <p style="color:rgba(255,255,255,0.4);max-width:400px;margin:0 auto 2rem;">Please try again or contact support if the problem persists.</p>
    <a href="/" class="btn btn-gold"><i class="fa-solid fa-house"></i> Return Home</a>
  </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</body></html>
