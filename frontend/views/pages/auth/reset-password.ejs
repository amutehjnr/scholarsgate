<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Reset Password | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-section">
      <a href="/"><div class="auth-logo-mark">S</div></a>
      <h1 class="auth-title">Set New Password</h1>
      <p class="auth-subtitle">Enter your new password below</p>
    </div>
    <% if (typeof flash !== 'undefined' && flash.error) { %>
      <div class="alert alert-danger"><i class="fa-solid fa-circle-xmark"></i><span><%= flash.error %></span></div>
    <% } %>
    <form action="/auth/reset-password/<%= token %>" method="POST" data-validate class="form-dark">
      <div class="form-group">
        <label class="form-label">New Password</label>
        <input type="password" name="password" class="form-control" placeholder="Min. 8 characters" required minlength="8"/>
      </div>
      <div class="form-group">
        <label class="form-label">Confirm Password</label>
        <input type="password" name="confirmPassword" class="form-control" placeholder="Repeat password" required/>
      </div>
      <button type="submit" class="btn btn-gold w-full btn-lg">Set New Password</button>
    </form>
    <p class="auth-footer-text"><a href="/auth/login">Back to Login</a></p>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
