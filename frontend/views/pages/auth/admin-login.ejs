<!-- admin-login.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-section">
      <div class="auth-logo-mark" style="background:linear-gradient(135deg,#1a2448,#2a3a68);"><i class="fa-solid fa-shield" style="color:#c9a84c;font-size:1.3rem;"></i></div>
      <h1 class="auth-title">Admin Portal</h1>
      <p class="auth-subtitle">Authorized personnel only</p>
    </div>
    <% if (typeof flash !== 'undefined' && flash.error) { %>
      <div class="alert alert-danger"><i class="fa-solid fa-circle-xmark"></i><span><%= flash.error %></span></div>
    <% } %>
    <form action="/auth/admin/login" method="POST" class="form-dark">
      <div class="form-group">
        <label class="form-label">Admin Email</label>
        <input type="email" name="email" class="form-control" placeholder="admin@scholarsgate.com" required />
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter password" required />
      </div>
      <button type="submit" class="btn btn-gold w-full btn-lg">Access Dashboard</button>
    </form>
    <p class="auth-footer-text"><a href="/auth/login">← Parent Login</a></p>
  </div>
</div>
<script src="/js/main.js"></script>
</body>
</html>
