<!-- forgot-password.ejs -->
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Forgot Password | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head><body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo-section">
      <a href="/"><div class="auth-logo-mark">S</div></a>
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-subtitle">We'll send a reset link to your email</p>
    </div>
    <% if (typeof flash !== 'undefined' && flash.success) { %><div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><span><%= flash.success %></span></div><% } %>
    <form action="/auth/forgot-password" method="POST" class="form-dark">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-control" placeholder="your@email.com" required/>
      </div>
      <button type="submit" class="btn btn-gold w-full btn-lg">Send Reset Link</button>
    </form>
    <p class="auth-footer-text"><a href="/auth/login">← Back to Login</a></p>
  </div>
</div>
<script src="/js/main.js"></script></body></html>
