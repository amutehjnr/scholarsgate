<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Pay Acceptance Fee | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">

    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Pay Acceptance Fee</div>
          <div class="breadcrumb">
            <a href="/parent/offers">Offers</a>
            <span class="breadcrumb-sep">/</span>
            <span>Acceptance Fee</span>
          </div>
        </div>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <div class="dashboard-content">

      <!-- Progress Steps -->
      <div style="background:#fff;border-radius:16px;padding:1.5rem 2rem;box-shadow:var(--shadow-sm);border:var(--border-dark);margin-bottom:1.5rem;max-width:1100px;">
        <div style="display:flex;align-items:center;gap:0;">

          <!-- Step 1: Accept Offer — DONE -->
          <div style="display:flex;align-items:center;flex:1;">
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.4rem;">
              <div style="width:36px;height:36px;border-radius:50%;background:var(--color-success-bg);border:2px solid var(--color-success-light);display:flex;align-items:center;justify-content:center;">
                <i class="fa-solid fa-check" style="color:var(--color-success-light);font-size:0.75rem;"></i>
              </div>
              <span style="font-size:0.65rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-success-light);">Accepted</span>
            </div>
            <div style="flex:1;height:2px;background:var(--color-gold);margin:0 0.5rem;margin-bottom:1.2rem;"></div>
          </div>

          <!-- Step 2: Acceptance Fee — CURRENT -->
          <div style="display:flex;align-items:center;flex:1;">
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.4rem;">
              <div style="width:36px;height:36px;border-radius:50%;background:var(--gradient-gold);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-gold-sm);">
                <i class="fa-solid fa-file-invoice-dollar" style="color:var(--color-obsidian);font-size:0.75rem;"></i>
              </div>
              <span style="font-size:0.65rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-gold-dim);">Acceptance Fee</span>
            </div>
            <div style="flex:1;height:2px;background:rgba(0,0,0,0.08);margin:0 0.5rem;margin-bottom:1.2rem;"></div>
          </div>

          <!-- Step 3: Enrollment Deposit — PENDING -->
          <div style="display:flex;align-items:center;flex:1;">
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.4rem;">
              <div style="width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,0.04);border:2px solid rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;">
                <span style="font-size:0.75rem;font-weight:700;color:rgba(0,0,0,0.3);">3</span>
              </div>
              <span style="font-size:0.65rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-text-muted);">Enroll Deposit</span>
            </div>
            <div style="flex:1;height:2px;background:rgba(0,0,0,0.08);margin:0 0.5rem;margin-bottom:1.2rem;"></div>
          </div>

          <!-- Step 4: Confirmed — PENDING -->
          <div style="display:flex;flex-direction:column;align-items:center;gap:0.4rem;">
            <div style="width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,0.04);border:2px solid rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;">
              <span style="font-size:0.75rem;font-weight:700;color:rgba(0,0,0,0.3);">4</span>
            </div>
            <span style="font-size:0.65rem;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-text-muted);">Confirmed</span>
          </div>

        </div>
      </div>

      <div style="display:grid;grid-template-columns:1.5fr 1fr;gap:2rem;max-width:1100px;">

        <!-- ─── LEFT COLUMN ─────────────────────────────── -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Amount Display -->
          <div class="deposit-amount-display">
            <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">
              Acceptance Fee Required
            </div>
            <div class="deposit-amount-value">
              $<%= (offer.acceptanceFee || 0).toLocaleString() %>
            </div>
            <div style="font-size:0.8rem;color:var(--color-text-muted);margin-top:0.5rem;">
              <%= bankDetails?.currency || 'USD' %> — Paid upon accepting the offer
            </div>
          </div>

          <!-- What is acceptance fee info box -->
          <div style="padding:1.25rem 1.5rem;background:rgba(201,168,76,0.05);border-radius:12px;border:1px solid rgba(201,168,76,0.2);">
            <div style="font-weight:700;font-size:0.875rem;color:var(--color-gold-dim);margin-bottom:0.5rem;">
              <i class="fa-solid fa-circle-info" style="margin-right:6px;"></i>What is the Acceptance Fee?
            </div>
            <p style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.7;">
              The acceptance fee confirms your intent to enroll at <strong><%= offer.school?.name %></strong>.
              This fee is separate from the enrollment deposit and is paid first to secure your place in the
              admissions process. Once verified, you will proceed to pay the enrollment deposit of
              <strong>$<%= (offer.enrollmentDeposit || 500).toLocaleString() %></strong> to fully confirm your seat.
            </p>
          </div>

          <!-- Bank Details -->
          <div class="bank-details-card">
            <h3>Payment Details</h3>
            <% if (bankDetails) { %>
              <% if (bankDetails.bankName) { %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Bank Name</span>
                <span class="bank-detail-value"><%= bankDetails.bankName %></span>
              </div>
              <% } %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Account Name</span>
                <span class="bank-detail-value"><%= bankDetails.accountName %></span>
              </div>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Account Number</span>
                <span class="bank-detail-value"><%= bankDetails.accountNumber %></span>
              </div>
              <% if (bankDetails.routingNumber) { %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Routing (ABA)</span>
                <span class="bank-detail-value"><%= bankDetails.routingNumber %></span>
              </div>
              <% } %>
              <% if (bankDetails.swiftCode) { %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">SWIFT / BIC</span>
                <span class="bank-detail-value"><%= bankDetails.swiftCode %></span>
              </div>
              <% } %>
              <% if (bankDetails.iban) { %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">IBAN</span>
                <span class="bank-detail-value"><%= bankDetails.iban %></span>
              </div>
              <% } %>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Reference</span>
                <span style="font-weight:600;color:var(--color-gold);font-size:0.875rem;">
                  AF-<%= offer.offerNumber %>
                </span>
              </div>
              <div class="bank-detail-row">
                <span class="bank-detail-label">Amount</span>
                <span class="bank-detail-value">
                  $<%= (offer.acceptanceFee || 0).toLocaleString() %> <%= bankDetails.currency || 'USD' %>
                </span>
              </div>
              <div style="margin-top:1rem;padding:0.875rem;background:rgba(201,168,76,0.08);border-radius:10px;border:1px solid rgba(201,168,76,0.15);">
                <p style="font-size:0.75rem;color:rgba(255,255,255,0.5);line-height:1.7;">
                  <i class="fa-solid fa-info-circle" style="color:var(--color-gold);margin-right:6px;"></i>
                  Use reference <strong style="color:var(--color-gold);">AF-<%= offer.offerNumber %></strong> so we can match your payment.
                  <% if (bankDetails.instructions) { %><br/><br/><%= bankDetails.instructions %><% } %>
                </p>
              </div>
            <% } else { %>
              <div style="padding:2rem;text-align:center;">
                <i class="fa-solid fa-triangle-exclamation" style="font-size:2.5rem;color:var(--color-warning);margin-bottom:1rem;display:block;"></i>
                <p style="font-size:0.875rem;color:rgba(255,255,255,0.5);">
                  Payment details not configured. Contact
                  <a href="mailto:payments@scholarsgate.com" style="color:var(--color-gold);">payments@scholarsgate.com</a>
                </p>
              </div>
            <% } %>
          </div>

          <!-- Upload Form -->
          <div class="data-table-wrap" style="padding:1.75rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:0.5rem;">
              Upload Payment Proof
            </h3>
            <p style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:1.5rem;">
              Upload your receipt or transfer confirmation for the acceptance fee.
            </p>

            <% if (existingPayment && existingPayment.status === 'verified') { %>
              <div class="alert alert-success">
                <i class="fa-solid fa-circle-check"></i>
                <span>Acceptance fee verified! You can now proceed to pay the enrollment deposit.</span>
              </div>
              <a href="/parent/offers/<%= offer._id %>/payment" class="btn btn-gold w-full btn-lg" style="margin-top:1rem;justify-content:center;">
                <i class="fa-solid fa-arrow-right"></i> Proceed to Enrollment Deposit
              </a>
            <% } else { %>
              <form action="/parent/offers/<%= offer._id %>/acceptance-fee" method="POST" enctype="multipart/form-data" data-validate>

                <div class="form-group">
                  <label class="form-label">Payment Method <span class="required">*</span></label>
                  <select name="paymentMethod" class="form-control form-select" required>
                    <option value="">Select method...</option>
                    <option value="wire_transfer"  <%= existingPayment?.paymentMethod === 'wire_transfer'  ? 'selected' : '' %>>Wire Transfer</option>
                    <option value="bank_transfer"  <%= existingPayment?.paymentMethod === 'bank_transfer'  ? 'selected' : '' %>>Bank Transfer</option>
                    <option value="western_union"  <%= existingPayment?.paymentMethod === 'western_union'  ? 'selected' : '' %>>Western Union</option>
                    <option value="paypal"         <%= existingPayment?.paymentMethod === 'paypal'         ? 'selected' : '' %>>PayPal</option>
                    <option value="other"          <%= existingPayment?.paymentMethod === 'other'          ? 'selected' : '' %>>Other</option>
                  </select>
                </div>

                <div class="form-group">
                  <label class="form-label">Transaction Reference Number</label>
                  <input type="text" name="referenceNumber" class="form-control"
                    placeholder="e.g. TXN-2024-XXXXXXXX"
                    value="<%= existingPayment?.referenceNumber || '' %>"/>
                </div>

                <div class="form-group">
                  <label class="form-label">Payment Proof <span class="required">*</span></label>
                  <div class="upload-zone" style="position:relative;">
                    <input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png" required
                      style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;"/>
                    <div class="upload-prompt">
                      <span class="upload-icon" style="font-size:2.5rem;">📎</span>
                      <div style="font-weight:600;color:var(--color-text-primary);margin-bottom:0.25rem;">Click or drag file here</div>
                      <div style="font-size:0.8rem;color:var(--color-text-muted);">PDF, JPG, or PNG · Max 10MB</div>
                    </div>
                    <div class="upload-success" style="display:none;">
                      <span style="font-size:2rem;">✅</span>
                      <div style="font-weight:600;color:var(--color-success-light);">File selected</div>
                      <div class="upload-file-name" style="font-size:0.8rem;color:var(--color-text-muted);"></div>
                    </div>
                  </div>
                  <% if (existingPayment?.proofOfPayment?.url) { %>
                  <div style="margin-top:0.75rem;padding:0.75rem;background:var(--color-info-bg);border-radius:8px;border:1px solid rgba(26,58,106,0.1);display:flex;align-items:center;justify-content:space-between;">
                    <span style="font-size:0.8rem;color:var(--color-info);">
                      <i class="fa-solid fa-file-image" style="margin-right:6px;"></i>Previous upload on file.
                    </span>
                    <a href="<%= existingPayment.proofOfPayment.url %>" target="_blank"
                      style="font-size:0.75rem;font-weight:600;color:var(--color-info);text-decoration:none;">View ↗</a>
                  </div>
                  <% } %>
                </div>

                <% if (existingPayment && existingPayment.status === 'pending') { %>
                <div class="alert alert-warning" style="margin-bottom:1rem;">
                  <i class="fa-solid fa-clock"></i>
                  <span>Acceptance fee under review (24–48 hours).</span>
                </div>
                <% } else if (existingPayment && existingPayment.status === 'rejected') { %>
                <div class="alert alert-danger" style="margin-bottom:1rem;">
                  <i class="fa-solid fa-circle-xmark"></i>
                  <span><%= existingPayment.rejectionReason || 'Payment rejected.' %> Please resubmit.</span>
                </div>
                <% } %>

                <button type="submit" class="btn btn-gold btn-lg w-full" style="justify-content:center;">
                  <i class="fa-solid fa-upload"></i> Submit Acceptance Fee Proof
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <!-- ─── RIGHT COLUMN ────────────────────────────── -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Fee Breakdown -->
          <div class="data-table-wrap" style="padding:1.5rem;border:1px solid rgba(201,168,76,0.2);">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-gold);margin-bottom:1.25rem;">
              Payment Breakdown
            </div>

            <div style="display:flex;flex-direction:column;gap:0.875rem;">
              <!-- Acceptance Fee - Current -->
              <div style="padding:1rem;background:rgba(201,168,76,0.06);border-radius:12px;border:1px solid rgba(201,168,76,0.2);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
                  <div style="display:flex;align-items:center;gap:0.5rem;">
                    <div style="width:8px;height:8px;border-radius:50%;background:var(--color-gold);"></div>
                    <span style="font-size:0.8rem;font-weight:700;color:var(--color-gold-dim);">Acceptance Fee</span>
                    <span style="background:rgba(201,168,76,0.15);color:var(--color-gold-dim);font-size:0.6rem;font-weight:700;padding:1px 6px;border-radius:99px;">NOW</span>
                  </div>
                  <span style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--color-gold-dim);">
                    $<%= (offer.acceptanceFee || 0).toLocaleString() %>
                  </span>
                </div>
                <div style="font-size:0.75rem;color:var(--color-text-muted);">Confirms your intent to enroll</div>
              </div>

              <!-- Enrollment Deposit - Next -->
              <div style="padding:1rem;background:rgba(0,0,0,0.02);border-radius:12px;border:var(--border-dark);">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.375rem;">
                  <div style="display:flex;align-items:center;gap:0.5rem;">
                    <div style="width:8px;height:8px;border-radius:50%;background:rgba(0,0,0,0.15);"></div>
                    <span style="font-size:0.8rem;font-weight:600;color:var(--color-text-secondary);">Enrollment Deposit</span>
                    <span style="background:rgba(0,0,0,0.05);color:var(--color-text-muted);font-size:0.6rem;font-weight:700;padding:1px 6px;border-radius:99px;">NEXT</span>
                  </div>
                  <span style="font-size:1rem;font-weight:700;color:var(--color-text-secondary);">
                    $<%= (offer.enrollmentDeposit || 500).toLocaleString() %>
                  </span>
                </div>
                <div style="font-size:0.75rem;color:var(--color-text-muted);">Secures your seat after acceptance fee is verified</div>
              </div>

              <!-- Total -->
              <div style="padding:0.875rem 1rem;background:var(--gradient-navy);border-radius:12px;">
                <div style="display:flex;align-items:center;justify-content:space-between;">
                  <span style="font-size:0.8rem;font-weight:700;color:rgba(255,255,255,0.6);">Total Fees</span>
                  <span style="font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:700;color:var(--color-gold);">
                    $<%= ((offer.acceptanceFee || 0) + (offer.enrollmentDeposit || 500)).toLocaleString() %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Offer Summary -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">Offer Summary</div>
            <div style="display:flex;align-items:center;gap:0.875rem;margin-bottom:1.25rem;padding-bottom:1.25rem;border-bottom:var(--border-dark);">
              <div style="width:44px;height:44px;border-radius:10px;background:var(--gradient-navy);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--color-gold);font-size:1.1rem;flex-shrink:0;">
                <%= (offer.school?.name || 'S')[0] %>
              </div>
              <div>
                <div style="font-weight:700;font-size:0.95rem;"><%= offer.school?.name %></div>
                <div style="font-size:0.8rem;color:var(--color-text-muted);"><%= offer.scholarship?.name || 'Scholarship Offer' %></div>
              </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.5rem;">
              <div style="display:flex;justify-content:space-between;font-size:0.8rem;">
                <span style="color:var(--color-text-muted);">Offer Number</span>
                <span style="font-weight:600;font-family:monospace;">#<%= offer.offerNumber %></span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:0.8rem;">
                <span style="color:var(--color-text-muted);">Coverage</span>
                <span style="font-weight:700;color:var(--color-gold-dim);">
                  <%= offer.scholarshipDetails?.coveragePercentage || 0 %>%
                </span>
              </div>
              <div style="display:flex;justify-content:space-between;font-size:0.8rem;">
                <span style="color:var(--color-text-muted);">Offer Expires</span>
                <span style="font-weight:600;">
                  <%= new Date(offer.expiryDate).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %>
                </span>
              </div>
            </div>
          </div>

          <!-- Help -->
          <div style="padding:1.25rem;background:var(--color-info-bg);border-radius:12px;border:1px solid rgba(26,58,106,0.12);">
            <div style="font-weight:600;font-size:0.875rem;color:var(--color-info);margin-bottom:0.5rem;">
              <i class="fa-solid fa-headset" style="margin-right:6px;"></i>Need Help?
            </div>
            <p style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.7;margin-bottom:0.5rem;">
              Questions about the acceptance fee?
            </p>
            <a href="mailto:payments@scholarsgate.com" style="font-size:0.8rem;font-weight:600;color:var(--color-info);text-decoration:none;">
              payments@scholarsgate.com ↗
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<div id="toast-container"></div>
<style>
  #toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}
  .toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}
  .toast.show{transform:translateX(0);opacity:1;}
  @media(max-width:768px){
    .dashboard-content > div:last-child { grid-template-columns: 1fr !important; }
  }
</style>
<script src="/js/main.js"></script>
</body>
</html>
