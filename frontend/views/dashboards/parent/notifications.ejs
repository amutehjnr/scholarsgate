<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Notifications | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div><%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;"><i class="fa-solid fa-bars"></i></button>
        <div><div class="page-title-bar">Notifications</div></div>
      </div>
    </div>
    <div class="dashboard-content">
      <div style="max-width:680px;">
        <% const notifIcons={
          offer_issued:'🎉', application_submitted:'📋', application_update:'🔔',
          payment_submitted:'💳', payment_verified:'✅', payment_rejected:'❌',
          interview_scheduled:'📅', deadline_reminder:'⏰', welcome:'👋', system:'ℹ️'
        }; %>
        <% if(notifications.length===0){%>
        <div style="text-align:center;padding:4rem;background:#fff;border-radius:20px;box-shadow:var(--shadow-sm);border:var(--border-dark);">
          <div style="font-size:3rem;margin-bottom:1rem;opacity:0.3;"><i class="fa-solid fa-bell"></i></div>
          <h3 style="font-family:'Playfair Display',serif;">All Caught Up!</h3>
          <p style="color:var(--color-text-muted);margin-top:0.5rem;">No notifications yet.</p>
        </div>
        <%} else {%>
        <div style="background:#fff;border-radius:20px;box-shadow:var(--shadow-sm);border:var(--border-dark);overflow:hidden;">
          <% notifications.forEach((notif,i)=>{%>
          <div class="notification-item <%= !notif.isRead?'unread':'' %>">
            <div class="notif-icon-wrap <%= ['offer_issued','payment_verified'].includes(notif.type)?'success':['payment_rejected'].includes(notif.type)?'warning':'info' %>">
              <span style="font-size:1.1rem;"><%= notifIcons[notif.type]||'🔔' %></span>
            </div>
            <div class="notif-content">
              <div class="notif-title"><%= notif.title %></div>
              <div class="notif-message"><%= notif.message %></div>
              <div class="notif-time"><%= new Date(notif.createdAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
            </div>
            <% if(notif.link){%>
            <a href="<%= notif.link %>" class="btn btn-ghost btn-sm" style="flex-shrink:0;font-size:0.7rem;padding:0.25rem 0.75rem;">View</a>
            <%}%>
          </div>
          <%})%>
        </div>
        <%}%>
      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body></html>
