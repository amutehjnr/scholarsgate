<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title><%= student.firstName %> <%= student.lastName %> | ScholarsGate</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div><%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;"><i class="fa-solid fa-bars"></i></button>
        <div>
          <div class="page-title-bar"><%= student.firstName %> <%= student.lastName %></div>
          <div class="breadcrumb"><a href="/parent/students">Students</a><span class="breadcrumb-sep">/</span><span>Profile</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/scholarships" class="btn btn-gold btn-sm"><i class="fa-solid fa-star"></i> Find Scholarships</a>
      </div>
    </div>
    <%- include('../../partials/flash') %>
    <div class="dashboard-content">
      <div style="display:grid;grid-template-columns:300px 1fr;gap:1.5rem;">

        <!-- Profile Card -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="student-profile-card">
            <div class="student-profile-header">
              <div class="student-avatar-lg">
                <%if(student.avatar){%><img src="<%= student.avatar %>" alt=""/>
                <%}else{%><%= (student.firstName||'?')[0] %><%}%>
              </div>
              <h2 style="font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;color:var(--color-ivory);"><%= student.firstName %> <%= student.lastName %></h2>
              <p style="color:rgba(255,255,255,0.45);font-size:0.875rem;"><%= student.nationality %></p>
              <div class="profile-completion">
                <div style="font-size:0.65rem;color:rgba(255,255,255,0.3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:0.375rem;">Profile Completion</div>
                <div class="completion-bar"><div class="completion-fill" style="width:<%= student.profileCompletion||0 %>%;"></div></div>
                <div class="completion-text"><%= student.profileCompletion||0 %>%</div>
              </div>
            </div>
            <div style="padding:1.25rem;display:flex;flex-direction:column;gap:0.75rem;">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                <div><div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">Grade Target</div><div style="font-weight:600;">Grade <%= student.intendedGrade %></div></div>
                <div><div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">GPA</div><div style="font-weight:700;color:var(--color-gold-dim);"><%= student.gpa||'N/A' %></div></div>
                <div><div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">Year</div><div style="font-weight:600;"><%= student.intendedYear||'N/A' %></div></div>
                <div><div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">English</div><div style="font-weight:600;font-size:0.8rem;"><%= student.englishProficiency?.test||'N/A' %><% if(student.englishProficiency?.score){%> · <%= student.englishProficiency.score %><%}%></div></div>
              </div>
            </div>
          </div>

          <!-- Documents -->
          <div class="data-table-wrap" style="padding:1.25rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1rem;margin-bottom:1rem;">Documents</h3>
            <% const docTypes=[{key:'transcript',label:'Transcript',icon:'fa-file-lines'},{key:'passport',label:'Passport',icon:'fa-passport'},{key:'englishTest',label:'English Test',icon:'fa-language'},{key:'recommendationLetter',label:'Recommendation',icon:'fa-file-signature'},{key:'photo',label:'Photo',icon:'fa-image'}]; %>
            <% docTypes.forEach(doc=>{%>
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0.625rem 0;border-bottom:1px solid rgba(0,0,0,0.04);">
              <div style="display:flex;align-items:center;gap:0.625rem;">
                <i class="fa-solid <%= doc.icon %>" style="color:<%= student.documents?.[doc.key]?.url?'var(--color-success-light)':'var(--color-text-muted)' %>;font-size:0.875rem;width:16px;"></i>
                <span style="font-size:0.8rem;color:var(--color-text-secondary);"><%= doc.label %></span>
              </div>
              <% if(student.documents?.[doc.key]?.url){%>
              <a href="<%= student.documents[doc.key].url %>" target="_blank" style="font-size:0.7rem;color:var(--color-success-light);text-decoration:none;">View ↗</a>
              <%} else {%>
              <span style="font-size:0.7rem;color:var(--color-text-muted);">Missing</span>
              <%}%>
            </div>
            <%})%>
          </div>
        </div>

        <!-- Details -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">
          <div class="data-table-wrap" style="padding:1.5rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;">Academic Profile</h3>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;">
              <% const academicFields=[
                {label:'Current School',value:student.currentSchool},
                {label:'Current Grade',value:student.currentGrade},
                {label:'GPA',value:student.gpa?`${student.gpa} / 4.0`:null},
                {label:'SAT Total',value:student.satScore?.total?`${student.satScore.total}/1600`:null},
                {label:'Language of Instruction',value:student.languageOfInstruction},
                {label:'Passport Number',value:student.passportNumber},
              ]; %>
              <% academicFields.forEach(f=>{%>
              <div>
                <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;"><%= f.label %></div>
                <div style="font-weight:600;font-size:0.875rem;color:var(--color-text-primary);"><%= f.value||'—' %></div>
              </div>
              <%})%>
            </div>
            <% if(student.careerGoals){%>
            <div style="margin-top:1.25rem;padding:1rem;background:rgba(0,0,0,0.02);border-radius:10px;border-left:3px solid var(--color-gold);">
              <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Career Goals</div>
              <p style="font-size:0.875rem;color:var(--color-text-secondary);line-height:1.7;"><%= student.careerGoals %></p>
            </div>
            <%}%>
          </div>

          <!-- Applications -->
          <% if(applications.length){%>
          <div class="data-table-wrap">
            <div class="data-table-header">
              <h3>Applications</h3>
              <a href="/parent/applications" class="btn btn-ghost btn-sm">View All</a>
            </div>
            <% applications.forEach(app=>{%>
            <a href="/parent/applications/<%= app._id %>" class="application-row">
              <div class="app-school-logo"><%= (app.school?.name||'?')[0] %></div>
              <div class="app-info">
                <div class="app-school-name"><%= app.school?.name %></div>
                <div class="app-scholarship-name">#<%= app.applicationNumber %></div>
              </div>
              <div class="app-meta">
                <span class="badge status-<%= app.status %>" style="font-size:10px;"><%= app.status.replace(/_/g,' ') %></span>
              </div>
            </a>
            <%})%>
          </div>
          <%}%>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/js/main.js"></script>
</body></html>
