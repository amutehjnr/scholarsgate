<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Edit School | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">

    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Edit School</div>
          <div class="breadcrumb">
            <a href="/admin/schools">Schools</a>
            <span class="breadcrumb-sep">/</span>
            <span><%= school.name %></span>
          </div>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/schools/<%= school.slug %>" target="_blank" class="btn btn-ghost btn-sm">
          <i class="fa-solid fa-eye"></i> Preview
        </a>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <div class="dashboard-content">
      <div style="max-width:960px;">
        <form action="/admin/schools/<%= school._id %>/edit" method="POST" enctype="multipart/form-data">

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">

            <!-- ─── Basic Information ─────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;grid-column:1/-1;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-school" style="color:var(--color-gold);"></i> Basic Information
              </h3>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
                <div class="form-group">
                  <label class="form-label">School Name <span class="required">*</span></label>
                  <input type="text" name="name" class="form-control" required value="<%= school.name %>"/>
                </div>
                <div class="form-group">
                  <label class="form-label">Founded Year</label>
                  <input type="number" name="founded" class="form-control" value="<%= school.founded || '' %>" placeholder="1781" min="1600" max="2024"/>
                </div>
                <div class="form-group">
                  <label class="form-label">Type <span class="required">*</span></label>
                  <select name="type" class="form-control form-select" required>
                    <option value="boarding"     <%= school.type === 'boarding'     ? 'selected' : '' %>>Boarding</option>
                    <option value="day"          <%= school.type === 'day'          ? 'selected' : '' %>>Day School</option>
                    <option value="boarding-day" <%= school.type === 'boarding-day' ? 'selected' : '' %>>Boarding & Day</option>
                    <option value="online"       <%= school.type === 'online'       ? 'selected' : '' %>>Online</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label">Category <span class="required">*</span></label>
                  <select name="category" class="form-control form-select" required>
                    <option value="private"   <%= school.category === 'private'   ? 'selected' : '' %>>Private</option>
                    <option value="charter"   <%= school.category === 'charter'   ? 'selected' : '' %>>Charter</option>
                    <option value="magnet"    <%= school.category === 'magnet'    ? 'selected' : '' %>>Magnet</option>
                    <option value="military"  <%= school.category === 'military'  ? 'selected' : '' %>>Military</option>
                    <option value="religious" <%= school.category === 'religious' ? 'selected' : '' %>>Religious</option>
                  </select>
                </div>
                <div class="form-group" style="grid-column:1/-1;">
                  <label class="form-label">Overview <span class="required">*</span></label>
                  <textarea name="overview" class="form-control form-textarea" required rows="3"><%= school.overview %></textarea>
                </div>
                <div class="form-group" style="grid-column:1/-1;">
                  <label class="form-label">Mission Statement</label>
                  <textarea name="mission" class="form-control form-textarea" rows="2"><%= school.mission || '' %></textarea>
                </div>
              </div>
            </div>

            <!-- ─── Location ──────────────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-location-dot" style="color:var(--color-gold);"></i> Location
              </h3>
              <div class="form-group">
                <label class="form-label">Street Address</label>
                <input type="text" name="location[address]" class="form-control" value="<%= school.location?.address || '' %>" placeholder="123 Academy Road"/>
              </div>
              <div class="form-group">
                <label class="form-label">City <span class="required">*</span></label>
                <input type="text" name="location[city]" class="form-control" required value="<%= school.location?.city || '' %>"/>
              </div>
              <div class="form-group">
                <label class="form-label">State <span class="required">*</span></label>
                <input type="text" name="location[state]" class="form-control" required value="<%= school.location?.state || '' %>"/>
              </div>
              <div class="form-group">
                <label class="form-label">ZIP Code</label>
                <input type="text" name="location[zipCode]" class="form-control" value="<%= school.location?.zipCode || '' %>"/>
              </div>
            </div>

            <!-- ─── Tuition & Fees ─────────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;border:2px solid rgba(201,168,76,0.25);">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-dollar-sign" style="color:var(--color-gold);"></i> Tuition & Fees
              </h3>
              <p style="font-size:0.8rem;color:var(--color-text-muted);margin-bottom:1.25rem;">All amounts in USD per year</p>
              <div class="form-group">
                <label class="form-label">Annual Tuition (USD) <span class="required">*</span></label>
                <div style="position:relative;">
                  <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--color-text-muted);font-weight:600;">$</span>
                  <input type="number" name="tuition[annual]" class="form-control" required
                    value="<%= school.tuition?.annual || '' %>" placeholder="60000" style="padding-left:2rem;"/>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Boarding Fee (USD)</label>
                <div style="position:relative;">
                  <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--color-text-muted);font-weight:600;">$</span>
                  <input type="number" name="tuition[boarding]" class="form-control"
                    value="<%= school.tuition?.boarding || '' %>" placeholder="18000" style="padding-left:2rem;"/>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Other Fees (USD)</label>
                <div style="position:relative;">
                  <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:var(--color-text-muted);font-weight:600;">$</span>
                  <input type="number" name="tuition[fees]" class="form-control"
                    value="<%= school.tuition?.fees || '' %>" placeholder="4500" style="padding-left:2rem;"/>
                </div>
              </div>
              <!-- Total display -->
              <div style="padding:1rem;background:rgba(201,168,76,0.06);border-radius:10px;border:1px solid rgba(201,168,76,0.15);">
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:4px;">Total Annual Cost</div>
                <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;color:var(--color-gold-dim);">
                  $<%= ((school.tuition?.annual||0) + (school.tuition?.boarding||0) + (school.tuition?.fees||0)).toLocaleString() %>
                </div>
              </div>
            </div>

            <!-- ─── Statistics ─────────────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-chart-bar" style="color:var(--color-gold);"></i> Statistics
              </h3>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                <div class="form-group">
                  <label class="form-label">Total Students</label>
                  <input type="number" name="stats[totalStudents]" class="form-control" value="<%= school.stats?.totalStudents || '' %>" placeholder="1080"/>
                </div>
                <div class="form-group">
                  <label class="form-label">International Students</label>
                  <input type="number" name="stats[internationalStudents]" class="form-control" value="<%= school.stats?.internationalStudents || '' %>" placeholder="230"/>
                </div>
                <div class="form-group">
                  <label class="form-label">Student:Teacher Ratio</label>
                  <input type="text" name="stats[studentTeacherRatio]" class="form-control" value="<%= school.stats?.studentTeacherRatio || '' %>" placeholder="5:1"/>
                </div>
                <div class="form-group">
                  <label class="form-label">College Acceptance (%)</label>
                  <input type="number" name="stats[collegeAcceptanceRate]" class="form-control" value="<%= school.stats?.collegeAcceptanceRate || '' %>" min="0" max="100" placeholder="99"/>
                </div>
                <div class="form-group">
                  <label class="form-label">Average SAT Score</label>
                  <input type="number" name="stats[satAverage]" class="form-control" value="<%= school.stats?.satAverage || '' %>" min="400" max="1600" placeholder="1480"/>
                </div>
                <div class="form-group">
                  <label class="form-label">AP Courses Offered</label>
                  <input type="number" name="stats[apCourses]" class="form-control" value="<%= school.stats?.apCourses || '' %>" placeholder="42"/>
                </div>
              </div>
            </div>

            <!-- ─── Contact Information ────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-address-card" style="color:var(--color-gold);"></i> Contact Information
              </h3>
              <div class="form-group">
                <label class="form-label">General Email</label>
                <input type="email" name="contactInfo[email]" class="form-control" value="<%= school.contactInfo?.email || '' %>" placeholder="info@school.edu"/>
              </div>
              <div class="form-group">
                <label class="form-label">Admissions Email</label>
                <input type="email" name="contactInfo[admissionsEmail]" class="form-control" value="<%= school.contactInfo?.admissionsEmail || '' %>" placeholder="admissions@school.edu"/>
              </div>
              <div class="form-group">
                <label class="form-label">Phone</label>
                <input type="tel" name="contactInfo[phone]" class="form-control" value="<%= school.contactInfo?.phone || '' %>" placeholder="+1 (555) 000-0000"/>
              </div>
              <div class="form-group">
                <label class="form-label">Website</label>
                <input type="url" name="contactInfo[website]" class="form-control" value="<%= school.contactInfo?.website || '' %>" placeholder="https://www.school.edu"/>
              </div>
            </div>

            <!-- ─── Images & Settings ─────────────────────── -->
            <div class="data-table-wrap" style="padding:1.75rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.5rem;">
                <i class="fa-solid fa-image" style="color:var(--color-gold);"></i> Images & Settings
              </h3>

              <!-- Current images preview -->
              <% if (school.images?.logo || school.images?.hero) { %>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:1.25rem;">
                <% if (school.images?.logo) { %>
                <div style="padding:0.75rem;background:rgba(0,0,0,0.03);border-radius:10px;border:var(--border-dark);text-align:center;">
                  <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Current Logo</div>
                  <img src="<%= school.images.logo %>" alt="Logo" style="height:50px;object-fit:contain;"/>
                </div>
                <% } %>
                <% if (school.images?.hero) { %>
                <div style="padding:0.75rem;background:rgba(0,0,0,0.03);border-radius:10px;border:var(--border-dark);text-align:center;">
                  <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Current Hero</div>
                  <img src="<%= school.images.hero %>" alt="Hero" style="height:50px;object-fit:cover;width:100%;border-radius:6px;"/>
                </div>
                <% } %>
              </div>
              <% } %>

              <div class="form-group">
                <label class="form-label">Replace Logo</label>
                <input type="file" name="logo" class="form-control" accept="image/*" style="padding:0.5rem;"/>
              </div>
              <div class="form-group">
                <label class="form-label">Replace Hero Image</label>
                <input type="file" name="hero" class="form-control" accept="image/*" style="padding:0.5rem;"/>
              </div>

              <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1rem;padding-top:1rem;border-top:var(--border-dark);">
                <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
                  <input type="checkbox" name="featured" value="true" <%= school.featured ? 'checked' : '' %> style="accent-color:var(--color-gold);width:16px;height:16px;"/>
                  <div>
                    <div style="font-size:0.875rem;font-weight:600;color:var(--color-text-primary);">Featured School</div>
                    <div style="font-size:0.75rem;color:var(--color-text-muted);">Show on homepage</div>
                  </div>
                </label>
                <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
                  <input type="checkbox" name="isActive" value="true" <%= school.isActive !== false ? 'checked' : '' %> style="accent-color:var(--color-gold);width:16px;height:16px;"/>
                  <div>
                    <div style="font-size:0.875rem;font-weight:600;color:var(--color-text-primary);">Active</div>
                    <div style="font-size:0.75rem;color:var(--color-text-muted);">Visible to the public</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- ─── Actions ───────────────────────────────── -->
            <div style="grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;background:#fff;border-radius:12px;box-shadow:var(--shadow-sm);border:var(--border-dark);">
              <div style="font-size:0.8rem;color:var(--color-text-muted);">
                <i class="fa-regular fa-clock" style="margin-right:4px;"></i>
                Last updated: <%= new Date(school.updatedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %>
              </div>
              <div style="display:flex;gap:1rem;">
                <a href="/admin/schools" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-gold btn-lg">
                  <i class="fa-solid fa-floppy-disk"></i> Save Changes
                </button>
              </div>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<div id="toast-container"></div>
<style>
  #toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}
  .toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}
  .toast.show{transform:translateX(0);opacity:1;}
</style>
<script src="/js/main.js"></script>
</body>
</html>
