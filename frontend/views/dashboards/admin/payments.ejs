<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Payment Verification | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;"><i class="fa-solid fa-bars"></i></button>
        <div>
          <div class="page-title-bar">Payment Verification</div>
          <div class="breadcrumb"><span>Admin</span><span class="breadcrumb-sep">/</span><span>Payments</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <% const pendingCount = payments.filter(p=>p.status==='pending').length; %>
        <% if (pendingCount > 0) { %>
        <span style="background:#fff8e0;color:#8a6000;border:1px solid rgba(201,168,76,0.3);border-radius:9999px;padding:0.25rem 0.875rem;font-size:0.75rem;font-weight:700;">
          <%= pendingCount %> Pending Review
        </span>
        <% } %>
      </div>
    </div>
    <%- include('../../partials/flash') %>

    <div class="dashboard-content">

      <!-- Summary badges -->
      <div style="display:flex;gap:0.75rem;margin-bottom:1.5rem;flex-wrap:wrap;">
        <span class="badge badge-warning" style="padding:0.4rem 1rem;font-size:0.75rem;">Pending: <%= payments.filter(p=>p.status==='pending').length %></span>
        <span class="badge badge-success" style="padding:0.4rem 1rem;font-size:0.75rem;">Verified: <%= payments.filter(p=>p.status==='verified').length %></span>
        <span class="badge badge-danger"  style="padding:0.4rem 1rem;font-size:0.75rem;">Rejected: <%= payments.filter(p=>p.status==='rejected').length %></span>
        <% const cryptoCount = payments.filter(p=>p.paymentMethod && p.paymentMethod.startsWith('crypto_')).length; %>
        <% if (cryptoCount > 0) { %>
        <span style="background:rgba(201,168,76,0.1);color:var(--color-gold-dim);border:1px solid rgba(201,168,76,0.3);border-radius:9999px;padding:0.4rem 1rem;font-size:0.75rem;font-weight:700;">
          <i class="fa-solid fa-coins" style="margin-right:4px;"></i>Crypto: <%= cryptoCount %>
        </span>
        <% } %>
      </div>

      <div class="data-table-wrap">
        <div class="data-table-header">
          <h3>All Payment Submissions</h3>
        </div>
        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Guardian</th>
                <th>School</th>
                <th>Type</th>
                <th>Method</th>
                <th>Amount</th>
                <th>Reference / TX</th>
                <th>Submitted</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(payment => {
                const isCrypto = payment.paymentMethod && payment.paymentMethod.startsWith('crypto_');
                const methodLabel = {
                  wire_transfer: 'Wire Transfer',
                  bank_transfer: 'Bank Transfer',
                  western_union: 'Western Union',
                  paypal: 'PayPal',
                  crypto_usdt: 'USDT',
                  crypto_btc: 'Bitcoin',
                  crypto_eth: 'Ethereum',
                  other: 'Other',
                }[payment.paymentMethod] || (payment.paymentMethod || '—');

                // Build block explorer link for crypto TX hashes
                let explorerUrl = null;
                if (isCrypto && payment.cryptoTxHash) {
                  if (payment.paymentMethod === 'crypto_usdt' && payment.cryptoNetwork === 'usdt-trc20') {
                    explorerUrl = `https://tronscan.org/#/transaction/${payment.cryptoTxHash}`;
                  } else if (payment.paymentMethod === 'crypto_btc') {
                    explorerUrl = `https://blockstream.info/tx/${payment.cryptoTxHash}`;
                  } else if (payment.paymentMethod === 'crypto_eth' || payment.paymentMethod === 'crypto_usdt') {
                    explorerUrl = `https://etherscan.io/tx/${payment.cryptoTxHash}`;
                  }
                }
              %>
              <tr style="<%= isCrypto ? 'background:rgba(201,168,76,0.02);' : '' %>">

                <!-- Guardian -->
                <td>
                  <div class="user-cell">
                    <div class="table-avatar"><%= (payment.guardian?.firstName||'?')[0] %></div>
                    <div>
                      <div class="table-name"><%= payment.guardian?.firstName %> <%= payment.guardian?.lastName %></div>
                      <div class="table-sub"><%= payment.guardian?.email %></div>
                    </div>
                  </div>
                </td>

                <!-- School -->
                <td style="font-size:0.8rem;max-width:120px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                  <%= payment.offer?.school?.name || '—' %>
                </td>

                <!-- Payment type badge -->
                <td>
                  <span class="badge badge-<%= payment.paymentType === 'acceptance_fee' ? 'warning' : 'info' %>" style="font-size:10px;">
                    <%= payment.paymentType === 'acceptance_fee' ? 'Acceptance Fee' : 'Enrollment Deposit' %>
                  </span>
                </td>

                <!-- Method -->
                <td>
                  <% if (isCrypto) { %>
                  <div style="display:flex;align-items:center;gap:0.375rem;">
                    <i class="fa-solid fa-coins" style="color:var(--color-gold);font-size:0.75rem;"></i>
                    <span style="font-size:0.8rem;font-weight:600;color:var(--color-gold-dim);"><%= methodLabel %></span>
                  </div>
                  <% if (payment.cryptoNetwork) { %>
                  <div style="font-size:0.65rem;color:var(--color-text-muted);margin-top:2px;text-transform:uppercase;letter-spacing:0.05em;"><%= payment.cryptoNetwork %></div>
                  <% } %>
                  <% } else { %>
                  <span style="font-size:0.8rem;text-transform:capitalize;"><%= methodLabel %></span>
                  <% } %>
                </td>

                <!-- Amount -->
                <td style="font-weight:700;color:var(--color-gold-dim);">$<%= (payment.amount||0).toLocaleString() %></td>

                <!-- Reference / TX Hash -->
                <td style="max-width:180px;">
                  <% if (isCrypto && payment.cryptoTxHash) { %>
                  <div style="font-family:monospace;font-size:0.65rem;color:var(--color-text-secondary);word-break:break-all;margin-bottom:4px;">
                    <%= payment.cryptoTxHash.length > 20 ? payment.cryptoTxHash.substring(0,10) + '…' + payment.cryptoTxHash.slice(-6) : payment.cryptoTxHash %>
                  </div>
                  <% if (explorerUrl) { %>
                  <a href="<%= explorerUrl %>" target="_blank" rel="noopener noreferrer"
                    style="font-size:0.65rem;font-weight:700;color:var(--color-gold-dim);text-decoration:none;display:inline-flex;align-items:center;gap:3px;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Verify on Chain
                  </a>
                  <% } %>
                  <% } else { %>
                  <span style="font-family:monospace;font-size:0.72rem;color:var(--color-text-muted);"><%= payment.referenceNumber || '—' %></span>
                  <% } %>
                </td>

                <!-- Date -->
                <td style="font-size:0.72rem;color:var(--color-text-muted);white-space:nowrap;">
                  <%= new Date(payment.submittedAt||payment.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
                </td>

                <!-- Status badge -->
                <td>
                  <span class="badge badge-<%= payment.status==='verified'?'success':payment.status==='rejected'?'danger':'warning' %>">
                    <%= payment.status %>
                  </span>
                </td>

                <!-- Actions -->
                <td>
                  <div class="table-actions">
                    <% if (payment.proofOfPayment?.url) { %>
                    <a href="<%= payment.proofOfPayment.url %>" target="_blank"
                      class="btn btn-ghost btn-sm" style="font-size:0.7rem;padding:0.25rem 0.75rem;" title="View Proof">
                      <i class="fa-solid fa-image"></i>
                    </a>
                    <% } %>
                    <% if (payment.status === 'pending' || payment.status === 'under_review') { %>
                    <button class="btn btn-gold btn-sm" style="font-size:0.7rem;padding:0.25rem 0.875rem;"
                      data-verify-payment
                      data-url="/admin/payments/<%= payment._id %>/verify"
                      data-action="verify">
                      <i class="fa-solid fa-check"></i> Verify
                    </button>
                    <button class="btn btn-danger btn-sm" style="font-size:0.7rem;padding:0.25rem 0.875rem;"
                      data-verify-payment
                      data-url="/admin/payments/<%= payment._id %>/verify"
                      data-action="reject">
                      <i class="fa-solid fa-xmark"></i> Reject
                    </button>
                    <% } %>
                  </div>
                  <!-- Crypto TX hash full view (expandable) -->
                  <% if (isCrypto && payment.cryptoTxHash) { %>
                  <div style="margin-top:4px;">
                    <button type="button" onclick="toggleTx(this)"
                      data-tx="<%= payment.cryptoTxHash %>"
                      style="font-size:0.65rem;color:var(--color-text-muted);background:none;border:none;cursor:pointer;padding:0;">
                      Show full TX ▾
                    </button>
                    <div class="tx-full" style="display:none;font-family:monospace;font-size:0.65rem;color:var(--color-text-secondary);word-break:break-all;margin-top:4px;padding:4px 6px;background:rgba(0,0,0,0.04);border-radius:4px;">
                      <%= payment.cryptoTxHash %>
                    </div>
                  </div>
                  <% } %>
                </td>

              </tr>
              <% }) %>
              <% if (payments.length === 0) { %>
              <tr><td colspan="9" style="text-align:center;padding:3rem;color:var(--color-text-muted);">No payment submissions yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="toast-container"></div>
<style>
  #toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}
  .toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}
  .toast.show{transform:translateX(0);opacity:1;}
</style>
<script src="/js/main.js"></script>
<script>
function toggleTx(btn) {
  const box = btn.nextElementSibling;
  const shown = box.style.display !== 'none';
  box.style.display = shown ? 'none' : 'block';
  btn.textContent = shown ? 'Show full TX ▾' : 'Hide TX ▴';
}
</script>
</body>
</html>
