<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Bank Details | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Bank Account Details</div>
          <div class="breadcrumb"><span>Admin</span><span class="breadcrumb-sep">/</span><span>Bank Details</span></div>
        </div>
      </div>
    </div>
    <%- include('../../partials/flash') %>
    <div class="dashboard-content">
      <div style="max-width:780px;display:flex;flex-direction:column;gap:1.5rem;">

        <!-- Info Banner -->
        <div style="padding:1.25rem 1.5rem;background:var(--color-info-bg);border-radius:12px;border:1px solid rgba(26,58,106,0.15);display:flex;align-items:flex-start;gap:1rem;">
          <i class="fa-solid fa-circle-info" style="color:var(--color-info);margin-top:2px;flex-shrink:0;"></i>
          <div>
            <div style="font-weight:600;font-size:0.875rem;color:var(--color-info);margin-bottom:3px;">These details appear on the parent payment page</div>
            <div style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.6;">Parents will see this information when submitting their enrollment deposit. Make sure all details are accurate before saving.</div>
          </div>
        </div>

        <!-- Form -->
        <div class="data-table-wrap" style="padding:2rem;">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.75rem;">
            <i class="fa-solid fa-building-columns" style="color:var(--color-gold);margin-right:0.75rem;"></i>Payment Account Information
          </h3>

          <form action="/admin/bank-details" method="POST">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">

              <div class="form-group">
                <label class="form-label">Account Name <span class="required">*</span></label>
                <input type="text" name="accountName" class="form-control" required
                  value="<%= bankDetails?.accountName || '' %>"
                  placeholder="e.g. ScholarsGate LLC"/>
              </div>

              <div class="form-group">
                <label class="form-label">Bank Name <span class="required">*</span></label>
                <input type="text" name="bankName" class="form-control" required
                  value="<%= bankDetails?.bankName || '' %>"
                  placeholder="e.g. JPMorgan Chase Bank N.A."/>
              </div>

              <div class="form-group">
                <label class="form-label">Account Number <span class="required">*</span></label>
                <input type="text" name="accountNumber" class="form-control" required
                  value="<%= bankDetails?.accountNumber || '' %>"
                  placeholder="e.g. 1234 5678 9012"/>
              </div>

              <div class="form-group">
                <label class="form-label">Routing Number (ABA)</label>
                <input type="text" name="routingNumber" class="form-control"
                  value="<%= bankDetails?.routingNumber || '' %>"
                  placeholder="e.g. 021 000 021"/>
              </div>

              <div class="form-group">
                <label class="form-label">SWIFT / BIC Code</label>
                <input type="text" name="swiftCode" class="form-control"
                  value="<%= bankDetails?.swiftCode || '' %>"
                  placeholder="e.g. CHASUS33"/>
              </div>

              <div class="form-group">
                <label class="form-label">IBAN</label>
                <input type="text" name="iban" class="form-control"
                  value="<%= bankDetails?.iban || '' %>"
                  placeholder="e.g. GB29 NWBK 6016 1331 9268 19"/>
              </div>

              <div class="form-group">
                <label class="form-label">PayPal Email</label>
                <input type="email" name="paypalEmail" class="form-control"
                  value="<%= bankDetails?.paypalEmail || '' %>"
                  placeholder="payments@scholarsgate.com"/>
              </div>

              <div class="form-group">
                <label class="form-label">Currency</label>
                <select name="currency" class="form-control form-select">
                  <option value="USD" <%= bankDetails?.currency === 'USD' ? 'selected' : '' %>>USD — US Dollar</option>
                  <option value="GBP" <%= bankDetails?.currency === 'GBP' ? 'selected' : '' %>>GBP — British Pound</option>
                  <option value="EUR" <%= bankDetails?.currency === 'EUR' ? 'selected' : '' %>>EUR — Euro</option>
                </select>
              </div>

              <div class="form-group" style="grid-column:1/-1;">
                <label class="form-label">Additional Payment Instructions</label>
                <textarea name="instructions" class="form-control form-textarea" rows="3"
                  placeholder="Any additional instructions for parents making the transfer..."><%= bankDetails?.instructions || '' %></textarea>
              </div>

            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:1.5rem;border-top:var(--border-dark);">
              <% if (bankDetails?.updatedAt) { %>
              <span style="font-size:0.75rem;color:var(--color-text-muted);">
                <i class="fa-regular fa-clock" style="margin-right:4px;"></i>
                Last updated: <%= new Date(bankDetails.updatedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
              </span>
              <% } else { %>
              <span style="font-size:0.75rem;color:var(--color-warning);">
                <i class="fa-solid fa-triangle-exclamation" style="margin-right:4px;"></i>
                No bank details set yet — parents cannot complete payments
              </span>
              <% } %>
              <button type="submit" class="btn btn-gold">
                <i class="fa-solid fa-floppy-disk"></i> Save Bank Details
              </button>
            </div>
          </form>
        </div>

        <!-- Preview Card -->
        <% if (bankDetails) { %>
        <div class="data-table-wrap" style="padding:1.75rem;">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.25rem;">
            <i class="fa-solid fa-eye" style="color:var(--color-gold);margin-right:0.75rem;"></i>Parent-Facing Preview
          </h3>
          <div style="background:var(--gradient-navy);border-radius:16px;padding:1.75rem;border:1px solid rgba(201,168,76,0.2);">
            <div style="font-family:'Playfair Display',serif;color:var(--color-gold);font-size:1.1rem;font-weight:700;margin-bottom:1.25rem;">Bank Transfer Details</div>
            <% const rows = [
              ['Bank Name', bankDetails.bankName],
              ['Account Name', bankDetails.accountName],
              ['Account Number', bankDetails.accountNumber],
              ['Routing (ABA)', bankDetails.routingNumber],
              ['SWIFT / BIC', bankDetails.swiftCode],
              ['IBAN', bankDetails.iban],
              ['PayPal', bankDetails.paypalEmail],
              ['Currency', bankDetails.currency],
            ]; %>
            <% rows.forEach(([label, value]) => { if(value) { %>
            <div style="display:flex;justify-content:space-between;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
              <span style="font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.35);"><%= label %></span>
              <span style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);"><%= value %></span>
            </div>
            <% }} ) %>
            <% if (bankDetails.instructions) { %>
            <div style="margin-top:1rem;padding:0.875rem;background:rgba(201,168,76,0.08);border-radius:10px;border:1px solid rgba(201,168,76,0.15);">
              <p style="font-size:0.8rem;color:rgba(255,255,255,0.5);line-height:1.7;"><%= bankDetails.instructions %></p>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</div>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}</style>
<script src="/js/main.js"></script>
</body></html>