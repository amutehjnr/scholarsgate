<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Bank & Payment Details | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Bank & Payment Details</div>
          <div class="breadcrumb"><span>Admin</span><span class="breadcrumb-sep">/</span><span>Payment Settings</span></div>
        </div>
      </div>
    </div>
    <%- include('../../partials/flash') %>

    <div class="dashboard-content">
      <div style="max-width:860px;display:flex;flex-direction:column;gap:1.5rem;">

        <!-- Info Banner -->
        <div style="padding:1.25rem 1.5rem;background:var(--color-info-bg);border-radius:12px;border:1px solid rgba(26,58,106,0.15);display:flex;align-items:flex-start;gap:1rem;">
          <i class="fa-solid fa-circle-info" style="color:var(--color-info);margin-top:2px;flex-shrink:0;"></i>
          <div>
            <div style="font-weight:600;font-size:0.875rem;color:var(--color-info);margin-bottom:3px;">These details appear on parent payment pages</div>
            <div style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.6;">Parents see this when submitting acceptance fees and enrollment deposits. Enable crypto to offer additional payment options.</div>
          </div>
        </div>

        <form action="/admin/bank-details" method="POST">

          <!-- ─── Traditional Bank Details ──────────────────────────────── -->
          <div class="data-table-wrap" style="padding:2rem;margin-bottom:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.75rem;">
              <i class="fa-solid fa-building-columns" style="color:var(--color-gold);margin-right:0.75rem;"></i>Bank Transfer Details
            </h3>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">

              <div class="form-group">
                <label class="form-label">Account Name <span class="required">*</span></label>
                <input type="text" name="accountName" class="form-control" required
                  value="<%= bankDetails?.accountName || '' %>" placeholder="e.g. ScholarsGate LLC"/>
              </div>

              <div class="form-group">
                <label class="form-label">Bank Name <span class="required">*</span></label>
                <input type="text" name="bankName" class="form-control" required
                  value="<%= bankDetails?.bankName || '' %>" placeholder="e.g. JPMorgan Chase Bank N.A."/>
              </div>

              <div class="form-group">
                <label class="form-label">Account Number <span class="required">*</span></label>
                <input type="text" name="accountNumber" class="form-control" required
                  value="<%= bankDetails?.accountNumber || '' %>" placeholder="e.g. 1234 5678 9012"/>
              </div>

              <div class="form-group">
                <label class="form-label">Routing Number (ABA)</label>
                <input type="text" name="routingNumber" class="form-control"
                  value="<%= bankDetails?.routingNumber || '' %>" placeholder="e.g. 021 000 021"/>
              </div>

              <div class="form-group">
                <label class="form-label">SWIFT / BIC Code</label>
                <input type="text" name="swiftCode" class="form-control"
                  value="<%= bankDetails?.swiftCode || '' %>" placeholder="e.g. CHASUS33"/>
              </div>

              <div class="form-group">
                <label class="form-label">IBAN</label>
                <input type="text" name="iban" class="form-control"
                  value="<%= bankDetails?.iban || '' %>" placeholder="e.g. GB29 NWBK 6016 1331 9268 19"/>
              </div>

              <div class="form-group">
                <label class="form-label">PayPal Email</label>
                <input type="email" name="paypalEmail" class="form-control"
                  value="<%= bankDetails?.paypalEmail || '' %>" placeholder="payments@scholarsgate.com"/>
              </div>

              <div class="form-group">
                <label class="form-label">Currency</label>
                <select name="currency" class="form-control form-select">
                  <option value="USD" <%= bankDetails?.currency === 'USD' || !bankDetails ? 'selected' : '' %>>USD — US Dollar</option>
                  <option value="GBP" <%= bankDetails?.currency === 'GBP' ? 'selected' : '' %>>GBP — British Pound</option>
                  <option value="EUR" <%= bankDetails?.currency === 'EUR' ? 'selected' : '' %>>EUR — Euro</option>
                </select>
              </div>

              <div class="form-group" style="grid-column:1/-1;">
                <label class="form-label">Additional Payment Instructions</label>
                <textarea name="instructions" class="form-control form-textarea" rows="3"
                  placeholder="Any additional instructions for parents making the transfer..."><%= bankDetails?.instructions || '' %></textarea>
              </div>

            </div>
          </div>

          <!-- ─── Crypto Payment Details ─────────────────────────────────── -->
          <div class="data-table-wrap" style="padding:2rem;margin-bottom:1.5rem;border:1px solid rgba(201,168,76,0.2);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
              <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;">
                <i class="fa-solid fa-coins" style="color:var(--color-gold);margin-right:0.75rem;"></i>Cryptocurrency Payments
              </h3>
              <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;padding:0.625rem 1rem;border-radius:8px;border:var(--border-dark);background:#fff;">
                <input type="checkbox" name="cryptoEnabled" id="cryptoEnabled" value="on"
                  <%= bankDetails?.cryptoEnabled ? 'checked' : '' %>
                  style="accent-color:var(--color-gold);width:16px;height:16px;"
                  onchange="toggleCrypto(this.checked)"/>
                <span style="font-size:0.875rem;font-weight:600;color:var(--color-text-primary);">Enable Crypto Payments</span>
              </label>
            </div>

            <div id="cryptoSection" style="display:<%= bankDetails?.cryptoEnabled ? 'block' : 'none' %>;">

              <!-- Info notice -->
              <div style="padding:1rem 1.25rem;background:rgba(201,168,76,0.06);border-radius:10px;border:1px solid rgba(201,168,76,0.2);margin-bottom:1.5rem;display:flex;align-items:flex-start;gap:0.875rem;">
                <i class="fa-solid fa-triangle-exclamation" style="color:var(--color-gold-dim);margin-top:2px;flex-shrink:0;"></i>
                <div style="font-size:0.8rem;color:var(--color-text-secondary);line-height:1.7;">
                  <strong>Important:</strong> Only enter wallet addresses you actively monitor. Crypto payments are irreversible. Always verify the transaction hash before confirming enrollment. Leave fields blank to hide unused networks from parents.
                </div>
              </div>

              <!-- USDT Wallets -->
              <div style="margin-bottom:1.5rem;">
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-gold-dim);margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:1px solid rgba(201,168,76,0.15);">
                  <i class="fa-solid fa-dollar-sign"></i> USDT (Tether)
                </div>
                <div style="display:flex;flex-direction:column;gap:0.875rem;">
                  <div class="form-group" style="margin:0;">
                    <label class="form-label">USDT — TRC20 (TRON Network) <span style="background:rgba(201,168,76,0.1);color:var(--color-gold-dim);font-size:0.65rem;padding:2px 8px;border-radius:99px;margin-left:6px;">Recommended</span></label>
                    <div style="position:relative;">
                      <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:0.7rem;font-weight:700;color:var(--color-text-muted);letter-spacing:0.1em;">TRC20</span>
                      <input type="text" name="cryptoUsdtTrc20" class="form-control"
                        value="<%= bankDetails?.cryptoAddresses?.usdtTrc20 || '' %>"
                        placeholder="T... (starts with T)"
                        style="padding-left:4.5rem;font-family:monospace;font-size:0.85rem;"/>
                    </div>
                  </div>
                  <div class="form-group" style="margin:0;">
                    <label class="form-label">USDT — ERC20 (Ethereum Network)</label>
                    <div style="position:relative;">
                      <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:0.7rem;font-weight:700;color:var(--color-text-muted);letter-spacing:0.1em;">ERC20</span>
                      <input type="text" name="cryptoUsdtErc20" class="form-control"
                        value="<%= bankDetails?.cryptoAddresses?.usdtErc20 || '' %>"
                        placeholder="0x... (starts with 0x)"
                        style="padding-left:4.5rem;font-family:monospace;font-size:0.85rem;"/>
                    </div>
                  </div>
                  <div class="form-group" style="margin:0;">
                    <label class="form-label">USDT — BEP20 (BNB Smart Chain)</label>
                    <div style="position:relative;">
                      <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:0.7rem;font-weight:700;color:var(--color-text-muted);letter-spacing:0.1em;">BEP20</span>
                      <input type="text" name="cryptoUsdtBep20" class="form-control"
                        value="<%= bankDetails?.cryptoAddresses?.usdtBep20 || '' %>"
                        placeholder="0x... (starts with 0x)"
                        style="padding-left:4.5rem;font-family:monospace;font-size:0.85rem;"/>
                    </div>
                  </div>
                </div>
              </div>

              <!-- BTC / ETH -->
              <div style="margin-bottom:1.5rem;">
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-gold-dim);margin-bottom:1rem;padding-bottom:0.5rem;border-bottom:1px solid rgba(201,168,76,0.15);">
                  <i class="fa-brands fa-bitcoin"></i> Bitcoin & Ethereum
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
                  <div class="form-group" style="margin:0;">
                    <label class="form-label">Bitcoin (BTC)</label>
                    <div style="position:relative;">
                      <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:0.7rem;font-weight:700;color:var(--color-text-muted);">BTC</span>
                      <input type="text" name="cryptoBitcoin" class="form-control"
                        value="<%= bankDetails?.cryptoAddresses?.bitcoin || '' %>"
                        placeholder="bc1... or 1... or 3..."
                        style="padding-left:3.5rem;font-family:monospace;font-size:0.85rem;"/>
                    </div>
                  </div>
                  <div class="form-group" style="margin:0;">
                    <label class="form-label">Ethereum (ETH)</label>
                    <div style="position:relative;">
                      <span style="position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:0.7rem;font-weight:700;color:var(--color-text-muted);">ETH</span>
                      <input type="text" name="cryptoEthereum" class="form-control"
                        value="<%= bankDetails?.cryptoAddresses?.ethereum || '' %>"
                        placeholder="0x..."
                        style="padding-left:3.5rem;font-family:monospace;font-size:0.85rem;"/>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Crypto Instructions -->
              <div class="form-group" style="margin:0;">
                <label class="form-label">Crypto Payment Instructions</label>
                <textarea name="cryptoInstructions" class="form-control form-textarea" rows="3"
                  placeholder="e.g. Send exact amount in USDT TRC20. Include your offer number in the memo/tag field if supported. Screenshot the transaction and upload as proof."
                  ><%= bankDetails?.cryptoInstructions || '' %></textarea>
              </div>

            </div><!-- /cryptoSection -->
          </div>

          <!-- ─── Save Button ────────────────────────────────────────────── -->
          <div style="display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;background:#fff;border-radius:12px;box-shadow:var(--shadow-sm);border:var(--border-dark);">
            <% if (bankDetails?.updatedAt) { %>
            <span style="font-size:0.75rem;color:var(--color-text-muted);">
              <i class="fa-regular fa-clock" style="margin-right:4px;"></i>
              Last updated: <%= new Date(bankDetails.updatedAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
            </span>
            <% } else { %>
            <span style="font-size:0.75rem;color:var(--color-warning);">
              <i class="fa-solid fa-triangle-exclamation" style="margin-right:4px;"></i>
              No payment details set yet
            </span>
            <% } %>
            <button type="submit" class="btn btn-gold">
              <i class="fa-solid fa-floppy-disk"></i> Save Payment Details
            </button>
          </div>

        </form>

        <!-- ─── Preview ───────────────────────────────────────────────────── -->
        <% if (bankDetails) { %>
        <div class="data-table-wrap" style="padding:1.75rem;">
          <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1.25rem;">
            <i class="fa-solid fa-eye" style="color:var(--color-gold);margin-right:0.75rem;"></i>Parent-Facing Preview
          </h3>

          <!-- Bank preview -->
          <div style="background:var(--gradient-navy);border-radius:16px;padding:1.75rem;border:1px solid rgba(201,168,76,0.2);margin-bottom:1rem;">
            <div style="font-family:'Playfair Display',serif;color:var(--color-gold);font-size:1.1rem;font-weight:700;margin-bottom:1.25rem;">Bank Transfer Details</div>
            <% const bankRows = [
              ['Bank Name',      bankDetails.bankName],
              ['Account Name',   bankDetails.accountName],
              ['Account Number', bankDetails.accountNumber],
              ['Routing (ABA)',  bankDetails.routingNumber],
              ['SWIFT / BIC',    bankDetails.swiftCode],
              ['IBAN',           bankDetails.iban],
              ['PayPal',         bankDetails.paypalEmail],
              ['Currency',       bankDetails.currency],
            ]; %>
            <% bankRows.forEach(([label, value]) => { if (value) { %>
            <div style="display:flex;justify-content:space-between;padding:0.625rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
              <span style="font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.35);"><%= label %></span>
              <span style="font-size:0.875rem;font-weight:600;color:var(--color-ivory);"><%= value %></span>
            </div>
            <% } }); %>
          </div>

          <!-- Crypto preview (only if enabled and at least one address set) -->
          <% const hasCrypto = bankDetails.cryptoEnabled && bankDetails.cryptoAddresses &&
            (bankDetails.cryptoAddresses.usdtTrc20 || bankDetails.cryptoAddresses.usdtErc20 ||
             bankDetails.cryptoAddresses.usdtBep20 || bankDetails.cryptoAddresses.bitcoin ||
             bankDetails.cryptoAddresses.ethereum); %>
          <% if (hasCrypto) { %>
          <div style="background:linear-gradient(135deg,#0f1524,#1a2240);border-radius:16px;padding:1.75rem;border:1px solid rgba(201,168,76,0.2);">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
              <i class="fa-solid fa-coins" style="color:var(--color-gold);font-size:1.1rem;"></i>
              <span style="font-family:'Playfair Display',serif;color:var(--color-gold);font-size:1.1rem;font-weight:700;">Cryptocurrency Payment</span>
            </div>
            <% const cryptoRows = [
              ['USDT TRC20', bankDetails.cryptoAddresses.usdtTrc20],
              ['USDT ERC20', bankDetails.cryptoAddresses.usdtErc20],
              ['USDT BEP20', bankDetails.cryptoAddresses.usdtBep20],
              ['Bitcoin (BTC)', bankDetails.cryptoAddresses.bitcoin],
              ['Ethereum (ETH)', bankDetails.cryptoAddresses.ethereum],
            ]; %>
            <% cryptoRows.forEach(([label, value]) => { if (value) { %>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:0.75rem 0;border-bottom:1px solid rgba(255,255,255,0.06);">
              <span style="font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.35);"><%= label %></span>
              <span style="font-size:0.8rem;font-weight:600;color:var(--color-ivory);font-family:monospace;word-break:break-all;max-width:340px;text-align:right;"><%= value %></span>
            </div>
            <% } }); %>
          </div>
          <% } %>
        </div>
        <% } %>

      </div>
    </div>
  </div>
</div>

<div id="toast-container"></div>
<style>
  #toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}
  .toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}
  .toast.show{transform:translateX(0);opacity:1;}
</style>
<script src="/js/main.js"></script>
<script>
function toggleCrypto(enabled) {
  document.getElementById('cryptoSection').style.display = enabled ? 'block' : 'none';
}
</script>
</body>
</html>
