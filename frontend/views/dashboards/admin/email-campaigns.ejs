// ── Select a segment card ────────────────────────────────────────────────────
function selectSegment(id, label, count) {
  activeSegment = id;
  activeCount   = count;
  activeLabel   = label;

  // Update card highlight
  document.querySelectorAll('.segment-card').forEach(c => c.classList.remove('selected'));
  document.getElementById('seg-' + id)?.classList.add('selected');

  // Update audience indicator
  document.getElementById('audienceLabel').textContent  = label;
  document.getElementById('audienceCount').textContent  = count;
  document.getElementById('noSegmentPrompt').style.display = 'none';
  document.getElementById('audienceIndicator').style.display = 'block';
  document.getElementById('campaignForm').style.display = 'block';
  document.getElementById('selectedSegment').value = id;

  // Reset sample list
  document.getElementById('sampleList').style.display = 'none';
  document.getElementById('sampleNames').textContent  = '';
}

// ── Preview audience (fetch sample) ─────────────────────────────────────────
async function previewAudience() {
  if (!activeSegment) { showToast('Select a segment first.', 'error'); return; }
  const btn = document.getElementById('previewBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Loading...';

  try {
    const res  = await fetch(`/admin/email-campaigns/preview?segment=${activeSegment}`);
    const data = await res.json();
    if (data.success) {
      document.getElementById('audienceCount').textContent      = data.count;
      document.getElementById('sampleNames').innerHTML =
        data.sample.map(s => `<span style="display:inline-block;background:rgba(0,0,0,0.06);border-radius:99px;padding:2px 10px;font-size:0.75rem;margin:2px;">${s.name} &lt;${s.email}&gt;</span>`).join('');
      document.getElementById('sampleList').style.display = 'block';
      showToast(`${data.count} recipients found.`, 'success');
    }
  } catch(e) {
    showToast('Failed to load preview.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-eye"></i> Preview Audience';
  }
}

// ── Load a template ──────────────────────────────────────────────────────────
function loadTemplate(key) {
  const tpl = TEMPLATES[key];
  if (!tpl) return;
  document.getElementById('emailSubject').value  = tpl.subject;
  document.getElementById('emailPreview').value  = tpl.preview;
  document.getElementById('emailEditor').innerHTML = tpl.body;
  showToast('Template loaded.', 'success');
}

// ── Toolbar helpers ──────────────────────────────────────────────────────────
function fmt(cmd) {
  document.getElementById('emailEditor').focus();
  document.execCommand(cmd, false, null);
}
function fmtHeading(tag) {
  document.getElementById('emailEditor').focus();
  document.execCommand('formatBlock', false, tag);
}
function insertLink() {
  const url = prompt('Enter URL:', 'https://');
  if (url) {
    document.getElementById('emailEditor').focus();
    document.execCommand('createLink', false, url);
  }
}
function insertTag(tag) {
  document.getElementById('emailEditor').focus();
  document.execCommand('insertText', false, `{{${tag}}}`);
}

// ── Send — open confirm modal ────────────────────────────────────────────────
function sendCampaign() {
  const subject  = document.getElementById('emailSubject').value.trim();
  const bodyHtml = document.getElementById('emailEditor').innerHTML.trim();

  if (!activeSegment)    { showToast('Please select an audience segment.', 'error'); return; }
  if (!subject)          { showToast('Please enter a subject line.', 'error'); return; }
  if (!bodyHtml || bodyHtml === '<br>') { showToast('Please write the email body.', 'error'); return; }
  if (activeCount === 0) { showToast('This segment has 0 recipients.', 'error'); return; }

  document.getElementById('confirmSegment').textContent = activeLabel;
  document.getElementById('confirmCount').textContent   = `${activeCount} parents`;
  document.getElementById('confirmSubject').textContent = subject;
  openModal('confirmModal');
}

// ── Confirmed — fire the API ─────────────────────────────────────────────────
async function confirmSend() {
  const btn = document.getElementById('confirmSendBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Sending...';

  const payload = {
    segment:     activeSegment,
    subject:     document.getElementById('emailSubject').value.trim(),
    previewText: document.getElementById('emailPreview').value.trim(),
    bodyHtml:    document.getElementById('emailEditor').innerHTML.trim(),
  };

  try {
    const res  = await fetch('/admin/email-campaigns/send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();

    closeModal('confirmModal');

    // Show result modal
    if (data.success) {
      document.getElementById('resultIcon').textContent    = '✅';
      document.getElementById('resultTitle').textContent   = 'Campaign Sent!';
      document.getElementById('resultMessage').textContent = data.message;
      document.getElementById('statSent').textContent      = data.sent   ?? '—';
      document.getElementById('statFailed').textContent    = data.failed ?? '0';
      document.getElementById('resultStats').style.display = 'flex';
    } else {
      document.getElementById('resultIcon').textContent    = '⚠️';
      document.getElementById('resultTitle').textContent   = 'Not Sent';
      document.getElementById('resultMessage').textContent = data.message || 'Something went wrong.';
      document.getElementById('resultStats').style.display = 'none';
    }
    openModal('resultModal');

  } catch(e) {
    closeModal('confirmModal');
    showToast('Network error. Please try again.', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Yes, Send Now';
  }
}
</script>
</body>
</html>
