<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Email Campaigns | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>

  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Email Campaigns</div>
          <div class="breadcrumb"><span>Admin</span><span class="breadcrumb-sep">/</span><span>Email Campaigns</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <span style="font-size:0.75rem;color:var(--color-text-muted);">
          From: <strong style="color:var(--color-text-secondary);">supports@schoolgatess.com</strong>
        </span>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <div class="dashboard-content">
      <div style="display:grid;grid-template-columns:1fr 1.6fr;gap:1.75rem;align-items:start;">

        <!-- ═══════════════════════════════════════════════════════════════
             LEFT — Segment cards + send history
        ════════════════════════════════════════════════════════════════ -->
        <div style="display:flex;flex-direction:column;gap:1.25rem;">

          <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-muted);">
            Choose Audience Segment
          </div>

          <% segments.forEach(seg => { %>
          <div class="segment-card"
            id="seg-<%= seg.id %>"
            onclick="selectSegment('<%= seg.id %>', '<%= seg.label %>', <%= seg.count %>)"
            style="padding:1.25rem 1.5rem;background:#fff;border-radius:14px;box-shadow:var(--shadow-sm);
            border:2px solid transparent;cursor:pointer;transition:all 0.2s;position:relative;overflow:hidden;">

            <!-- Left accent bar -->
            <div style="position:absolute;left:0;top:0;bottom:0;width:4px;
              background:<%= seg.color==='warning'?'#c9a84c':seg.color==='info'?'#1a3a6a':seg.color==='danger'?'#c0392b':'linear-gradient(180deg,#c9a84c,#e8c96a)' %>;">
            </div>

            <div style="display:flex;align-items:center;gap:1rem;padding-left:0.5rem;">
              <div style="width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
                background:<%= seg.color==='warning'?'rgba(201,168,76,0.1)':seg.color==='info'?'var(--color-info-bg)':seg.color==='danger'?'var(--color-danger-bg)':'rgba(201,168,76,0.12)' %>;">
                <i class="fa-solid <%= seg.icon %>"
                  style="font-size:1.1rem;color:<%= seg.color==='warning'?'#8a6000':seg.color==='info'?'var(--color-info)':seg.color==='danger'?'var(--color-danger-light)':'var(--color-gold-dim)' %>;"></i>
              </div>
              <div style="flex:1;min-width:0;">
                <div style="font-weight:700;font-size:0.875rem;color:var(--color-text-primary);margin-bottom:3px;">
                  <%= seg.label %>
                </div>
                <div style="font-size:0.775rem;color:var(--color-text-muted);line-height:1.4;">
                  <%= seg.description %>
                </div>
              </div>
              <div style="text-align:right;flex-shrink:0;">
                <div style="font-family:'Playfair Display',serif;font-size:1.5rem;font-weight:700;
                  color:<%= seg.color==='danger'?'var(--color-danger-light)':seg.color==='warning'?'#8a6000':'var(--color-text-primary)' %>;">
                  <%= seg.count %>
                </div>
                <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);">
                  recipients
                </div>
              </div>
            </div>
          </div>
          <% }) %>

          <!-- ── Send history ───────────────────────────────────────── -->
          <% if (history.length > 0) { %>
          <div class="data-table-wrap" style="padding:1.25rem;margin-top:0.5rem;">
            <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:1rem;">
              Recent Campaigns
            </div>
            <div style="display:flex;flex-direction:column;gap:0;">
              <% history.forEach(h => { %>
              <div style="padding:0.75rem 0;border-bottom:1px solid rgba(0,0,0,0.04);">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:0.5rem;">
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:0.8rem;font-weight:600;color:var(--color-text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                      <%= h.details?.subject || 'Campaign' %>
                    </div>
                    <div style="font-size:0.7rem;color:var(--color-text-muted);margin-top:2px;">
                      <%= h.details?.segment %> ·
                      <span style="color:var(--color-success-light);">✓ <%= h.details?.sent || 0 %> sent</span>
                      <% if(h.details?.failed > 0) { %> · <span style="color:var(--color-danger-light);">✗ <%= h.details.failed %> failed</span><% } %>
                    </div>
                  </div>
                  <div style="font-size:0.7rem;color:var(--color-text-muted);flex-shrink:0;text-align:right;">
                    <%= new Date(h.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>

        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             RIGHT — Compose panel
        ════════════════════════════════════════════════════════════════ -->
        <div class="data-table-wrap" style="padding:2rem;position:sticky;top:80px;">

          <!-- Selected audience indicator -->
          <div id="audienceIndicator"
            style="display:none;padding:0.875rem 1.25rem;background:rgba(201,168,76,0.06);
            border-radius:10px;border:1px solid rgba(201,168,76,0.2);margin-bottom:1.5rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;">
              <div>
                <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">Sending To</div>
                <div style="font-size:0.875rem;font-weight:700;color:var(--color-text-primary);" id="audienceLabel">—</div>
              </div>
              <div style="text-align:right;">
                <div id="audienceCount" style="font-family:'Playfair Display',serif;font-size:1.75rem;font-weight:700;color:var(--color-gold-dim);">—</div>
                <div style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);">recipients</div>
              </div>
            </div>
            <!-- Sample names preview -->
            <div id="sampleList" style="margin-top:0.75rem;display:none;">
              <div style="font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.375rem;">Sample recipients</div>
              <div id="sampleNames" style="font-size:0.775rem;color:var(--color-text-secondary);"></div>
            </div>
          </div>

          <!-- No segment selected prompt -->
          <div id="noSegmentPrompt" style="padding:2rem;text-align:center;background:rgba(0,0,0,0.02);border-radius:10px;border:var(--border-dark);margin-bottom:1.5rem;">
            <i class="fa-solid fa-arrow-left" style="font-size:1.5rem;color:var(--color-text-muted);opacity:0.4;margin-bottom:0.75rem;display:block;"></i>
            <div style="font-size:0.875rem;color:var(--color-text-muted);">Select an audience segment on the left to begin composing your email.</div>
          </div>

          <!-- Compose form -->
          <form id="campaignForm" style="display:none;" onsubmit="return false;">
            <input type="hidden" id="selectedSegment" name="segment" value=""/>

            <!-- Subject line -->
            <div class="form-group">
              <label class="form-label">Email Subject <span class="required">*</span></label>
              <input type="text" id="emailSubject" name="subject" class="form-control" required
                placeholder="e.g. Complete your child's profile — exclusive scholarships await!"/>
            </div>

            <!-- Preview text -->
            <div class="form-group">
              <label class="form-label">
                Preview Text
                <span style="font-size:0.7rem;font-weight:400;color:var(--color-text-muted);margin-left:6px;">(shown in inbox before opening)</span>
              </label>
              <input type="text" id="emailPreview" name="previewText" class="form-control"
                placeholder="e.g. Don't miss out — hundreds of scholarships are waiting for your child."/>
            </div>

            <!-- Template quick-fill buttons -->
            <div class="form-group">
              <label class="form-label">Quick Templates</label>
              <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
                <button type="button" class="btn btn-ghost btn-sm" onclick="loadTemplate('no_children')">
                  <i class="fa-solid fa-user-clock"></i> No Profile Yet
                </button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="loadTemplate('no_application')">
                  <i class="fa-solid fa-file-circle-xmark"></i> Never Applied
                </button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="loadTemplate('offer_expired')">
                  <i class="fa-solid fa-clock"></i> Offer Expired
                </button>
                <button type="button" class="btn btn-ghost btn-sm" onclick="loadTemplate('general')">
                  <i class="fa-solid fa-bullhorn"></i> General Broadcast
                </button>
              </div>
            </div>

            <!-- Personalization hint -->
            <div style="padding:0.75rem 1rem;background:var(--color-info-bg);border-radius:8px;border:1px solid rgba(26,58,106,0.12);margin-bottom:1.25rem;">
              <div style="font-size:0.75rem;color:var(--color-info);font-weight:600;margin-bottom:3px;">
                <i class="fa-solid fa-wand-magic-sparkles" style="margin-right:5px;"></i>Personalisation Tags
              </div>
              <div style="font-size:0.75rem;color:var(--color-text-secondary);line-height:1.6;">
                Use <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;">{{firstName}}</code>,
                <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;">{{lastName}}</code>, or
                <code style="background:rgba(0,0,0,0.06);padding:1px 5px;border-radius:3px;">{{fullName}}</code> — these are automatically replaced with each parent's real name.
              </div>
            </div>

            <!-- Rich body -->
            <div class="form-group">
              <label class="form-label">Email Body <span class="required">*</span></label>

              <!-- Toolbar -->
              <div style="display:flex;flex-wrap:wrap;gap:0.25rem;padding:0.5rem;background:rgba(0,0,0,0.03);border:1.5px solid rgba(0,0,0,0.12);border-bottom:none;border-radius:8px 8px 0 0;">
                <button type="button" onclick="fmt('bold')"          class="toolbar-btn" title="Bold"><b>B</b></button>
                <button type="button" onclick="fmt('italic')"        class="toolbar-btn" title="Italic"><i>I</i></button>
                <button type="button" onclick="fmt('underline')"     class="toolbar-btn" title="Underline"><u>U</u></button>
                <div style="width:1px;background:rgba(0,0,0,0.1);margin:2px 4px;"></div>
                <button type="button" onclick="fmtHeading('h2')"     class="toolbar-btn" title="Heading">H2</button>
                <button type="button" onclick="fmtHeading('h3')"     class="toolbar-btn" title="Sub-heading">H3</button>
                <div style="width:1px;background:rgba(0,0,0,0.1);margin:2px 4px;"></div>
                <button type="button" onclick="fmt('insertUnorderedList')" class="toolbar-btn" title="Bullet list"><i class="fa-solid fa-list-ul"></i></button>
                <button type="button" onclick="fmt('insertOrderedList')"   class="toolbar-btn" title="Numbered list"><i class="fa-solid fa-list-ol"></i></button>
                <div style="width:1px;background:rgba(0,0,0,0.1);margin:2px 4px;"></div>
                <button type="button" onclick="insertLink()"         class="toolbar-btn" title="Insert link"><i class="fa-solid fa-link"></i></button>
                <button type="button" onclick="insertTag('firstName')" class="toolbar-btn" title="Insert first name" style="font-size:0.65rem;padding:0 8px;">{{firstName}}</button>
                <div style="width:1px;background:rgba(0,0,0,0.1);margin:2px 4px;"></div>
                <button type="button" onclick="document.getElementById('emailEditor').innerHTML=''" class="toolbar-btn" title="Clear" style="color:var(--color-danger-light);">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>

              <!-- Contenteditable editor -->
              <div id="emailEditor"
                contenteditable="true"
                spellcheck="true"
                style="min-height:280px;max-height:460px;overflow-y:auto;
                padding:1.25rem;border:1.5px solid rgba(0,0,0,0.12);border-top:none;
                border-radius:0 0 8px 8px;font-size:0.9rem;line-height:1.8;
                color:var(--color-text-primary);outline:none;background:#fff;">
              </div>
              <p class="form-hint">This is what parents will read. Keep it warm, clear and actionable.</p>
            </div>

            <!-- Send button -->
            <div style="display:flex;align-items:center;gap:1rem;">
              <button type="button" onclick="previewAudience()" class="btn btn-ghost" id="previewBtn">
                <i class="fa-solid fa-eye"></i> Preview Audience
              </button>
              <button type="button" onclick="sendCampaign()" class="btn btn-gold btn-lg" id="sendBtn" style="flex:1;justify-content:center;">
                <i class="fa-solid fa-paper-plane"></i> Send Campaign
              </button>
            </div>

            <!-- Confirm modal trigger note -->
            <p style="font-size:0.75rem;color:var(--color-text-muted);text-align:center;margin-top:0.75rem;">
              A confirmation dialog will appear before sending. Emails are sent from <strong>supports@schoolgatess.com</strong>.
            </p>

          </form>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- ── Confirmation Modal ──────────────────────────────────────────────────── -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal" style="max-width:480px;">
    <div class="modal-header">
      <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;">Confirm Send</h3>
      <button onclick="closeModal('confirmModal')" style="background:none;border:none;cursor:pointer;font-size:1.25rem;color:var(--color-text-muted);">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="modal-body">
      <div style="background:rgba(201,168,76,0.06);border-radius:12px;border:1px solid rgba(201,168,76,0.2);padding:1.25rem;margin-bottom:1.25rem;">
        <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.75rem;">Summary</div>
        <table style="width:100%;border-collapse:collapse;">
          <tr>
            <td style="font-size:0.8rem;color:var(--color-text-muted);padding:5px 0;width:120px;">Segment</td>
            <td style="font-size:0.8rem;font-weight:600;color:var(--color-text-primary);" id="confirmSegment">—</td>
          </tr>
          <tr>
            <td style="font-size:0.8rem;color:var(--color-text-muted);padding:5px 0;">Recipients</td>
            <td style="font-size:0.8rem;font-weight:700;color:var(--color-gold-dim);" id="confirmCount">—</td>
          </tr>
          <tr>
            <td style="font-size:0.8rem;color:var(--color-text-muted);padding:5px 0;">Subject</td>
            <td style="font-size:0.8rem;font-weight:600;color:var(--color-text-primary);" id="confirmSubject">—</td>
          </tr>
          <tr>
            <td style="font-size:0.8rem;color:var(--color-text-muted);padding:5px 0;">From</td>
            <td style="font-size:0.8rem;color:var(--color-text-primary);">supports@schoolgatess.com</td>
          </tr>
        </table>
      </div>
      <div class="alert alert-warning" style="font-size:0.8rem;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>This action will send emails immediately to all recipients. It cannot be undone.</span>
      </div>
    </div>
    <div class="modal-footer" style="gap:0.75rem;">
      <button onclick="closeModal('confirmModal')" class="btn btn-ghost">Cancel</button>
      <button onclick="confirmSend()" class="btn btn-gold" id="confirmSendBtn">
        <i class="fa-solid fa-paper-plane"></i> Yes, Send Now
      </button>
    </div>
  </div>
</div>

<!-- ── Result Modal ───────────────────────────────────────────────────────── -->
<div class="modal-overlay" id="resultModal">
  <div class="modal" style="max-width:420px;">
    <div class="modal-body" style="text-align:center;padding:2.5rem 2rem;">
      <div id="resultIcon" style="font-size:3rem;margin-bottom:1rem;"></div>
      <h3 id="resultTitle" style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:0.5rem;"></h3>
      <p id="resultMessage" style="font-size:0.9rem;color:var(--color-text-muted);line-height:1.7;"></p>
      <div id="resultStats" style="display:none;margin-top:1.25rem;padding:1rem;background:rgba(0,0,0,0.03);border-radius:10px;display:flex;gap:1.5rem;justify-content:center;">
        <div style="text-align:center;">
          <div id="statSent" style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--color-success-light);"></div>
          <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);">Delivered</div>
        </div>
        <div style="text-align:center;">
          <div id="statFailed" style="font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--color-danger-light);"></div>
          <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-text-muted);">Failed</div>
        </div>
      </div>
      <button onclick="closeModal('resultModal');location.reload();" class="btn btn-gold" style="margin-top:1.5rem;">
        Done
      </button>
    </div>
  </div>
</div>

<div id="toast-container"></div>

<style>
/* ── Local styles ──────────────────────────────────────────────────────────── */
#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}
.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}
.toast.show{transform:translateX(0);opacity:1;}

.segment-card:hover {
  border-color: rgba(201,168,76,0.35) !important;
  box-shadow: var(--shadow-md) !important;
  transform: translateY(-2px);
}
.segment-card.selected {
  border-color: var(--color-gold) !important;
  box-shadow: var(--shadow-gold-sm) !important;
  background: rgba(201,168,76,0.03) !important;
}

.toolbar-btn {
  padding: 4px 10px;
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 5px;
  background: #fff;
  cursor: pointer;
  font-size: 0.8rem;
  color: var(--color-text-secondary);
  transition: all 0.15s;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
}
.toolbar-btn:hover {
  background: var(--color-gold);
  color: var(--color-obsidian);
  border-color: var(--color-gold);
}

#emailEditor:focus { border-color: var(--color-gold); box-shadow: 0 0 0 3px rgba(201,168,76,0.12); }
#emailEditor p, #emailEditor div { margin: 0 0 12px; }
#emailEditor h2 { font-size:1.3rem;font-weight:700;margin:16px 0 8px;color:var(--color-text-primary); }
#emailEditor h3 { font-size:1.1rem;font-weight:700;margin:14px 0 6px;color:var(--color-text-primary); }
#emailEditor ul, #emailEditor ol { padding-left:1.5rem;margin:0 0 12px; }
#emailEditor a { color: var(--color-gold); }
</style>

<script src="/js/main.js"></script>
<script>
// ── State ────────────────────────────────────────────────────────────────────
let activeSegment  = null;
let activeCount    = 0;
let activeLabel    = '';

// ── Email templates ──────────────────────────────────────────────────────────
const TEMPLATES = {
  no_children: {
    subject: 'Complete your child\'s profile — exclusive USA scholarships are waiting!',
    preview: 'Hundreds of fully-funded scholarships are available. It only takes 5 minutes to get started.',
    body: `<p>We noticed that you haven't yet added a student profile to your ScholarsGate account.</p>

<p>Creating a profile for <strong>{{firstName}}</strong>'s child is the first step toward accessing <strong>fully-funded scholarships</strong> at elite USA boarding schools — and it takes less than 5 minutes.</p>

<p><strong>Here's what you can access once your child's profile is complete:</strong></p>
<ul>
  <li>Hundreds of merit-based and full scholarships</li>
  <li>Partner schools offering up to 100% tuition coverage</li>
  <li>A simple, guided application process</li>
</ul>

<p>Don't let this opportunity pass. Log in now and add your child's profile to get started.</p>

<p>If you need any assistance, our admissions team is always happy to help at <a href="mailto:supports@schoolgatess.com">supports@schoolgatess.com</a>.</p>`,
  },

  no_application: {
    subject: 'Your child\'s profile is ready — apply for a scholarship today!',
    preview: 'You\'re one step away — submit your scholarship application before deadlines close.',
    body: `<p>Great news — your child's profile on ScholarsGate is set up and ready to go!</p>

<p>However, we noticed that <strong>you haven't yet submitted a scholarship application</strong>. Scholarship slots are limited and deadlines are approaching fast.</p>

<p><strong>Why apply now?</strong></p>
<ul>
  <li>Fully-funded scholarships covering tuition, boarding, meals and more</li>
  <li>Your child's profile is already complete — the application takes just minutes</li>
  <li>Some scholarships have only a few slots remaining</li>
</ul>

<p>Log in to your dashboard, browse available scholarships, and submit your application today. Our team reviews every application personally.</p>

<p>Questions? We're here at <a href="mailto:supports@schoolgatess.com">supports@schoolgatess.com</a>.</p>`,
  },

  offer_expired: {
    subject: 'Your offer letter has expired — we can help you reapply',
    preview: 'Don\'t worry — new scholarship opportunities are available. Let us help you get back on track.',
    body: `<p>We noticed that an offer letter we issued for your child has unfortunately expired without being accepted.</p>

<p>We understand that circumstances can change, and we want you to know that <strong>new scholarship opportunities are available</strong> on the platform.</p>

<p><strong>Here's what you can do right now:</strong></p>
<ul>
  <li>Browse new scholarships currently open for applications</li>
  <li>Apply to multiple schools to maximise your chances</li>
