<!-- scholarships.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Scholarships | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;"><i class="fa-solid fa-bars"></i></button>
        <div><div class="page-title-bar">Scholarships</div></div>
      </div>
      <div class="topbar-right">
        <button class="btn btn-gold btn-sm" data-open-modal="add-scholarship-modal"><i class="fa-solid fa-plus"></i> Add Scholarship</button>
      </div>
    </div>
    <%- include('../../partials/flash') %>
    <div class="dashboard-content">
      <div class="data-table-wrap">
        <div class="data-table-header">
          <h3>All Scholarships <span style="font-size:0.875rem;font-weight:500;color:var(--color-text-muted);">(<%= scholarships.length %>)</span></h3>
        </div>
        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr><th>Name</th><th>School</th><th>Type</th><th>Coverage</th><th>Value/Year</th><th>Deadline</th><th>Featured</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% scholarships.forEach(s => { %>
              <tr>
                <td><div class="table-name"><%= s.name %></div></td>
                <td style="font-size:0.8rem;"><%= s.school?.name %></td>
                <td><span class="badge badge-<%= s.type==='full'?'success':'info' %>" style="font-size:10px;"><%= s.type %></span></td>
                <td style="font-weight:700;color:var(--color-gold-dim);"><%= s.coveragePercentage %>%</td>
                <td style="font-weight:600;">$<%= (s.annualValue||0).toLocaleString() %></td>
                <td style="font-size:0.75rem;"><%= new Date(s.applicationDeadline).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
                <td><% if(s.featured){%><i class="fa-solid fa-star" style="color:var(--color-gold);"></i><%}else{%><i class="fa-regular fa-star" style="color:#ccc;"></i><%}%></td>
                <td><span class="badge badge-<%= s.isActive?'success':'danger' %>"><%= s.isActive?'Active':'Inactive' %></span></td>
              </tr>
              <% }) %>
              <% if(scholarships.length===0){%><tr><td colspan="8" style="text-align:center;padding:3rem;color:var(--color-text-muted);">No scholarships yet.</td></tr><%}%>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Scholarship Modal -->
<div class="modal-overlay" id="add-scholarship-modal">
  <div class="modal" style="max-width:700px;">
    <div class="modal-header">
      <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;">Add New Scholarship</h3>
      <button data-close-modal="add-scholarship-modal" style="background:none;border:none;cursor:pointer;font-size:1.25rem;color:var(--color-text-muted);"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <form action="/admin/scholarships" method="POST">
      <div class="modal-body" style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group" style="grid-column:1/-1;"><label class="form-label">Scholarship Name <span class="required">*</span></label><input type="text" name="name" class="form-control" required placeholder="Global Excellence Full Scholarship"/></div>
        <div class="form-group"><label class="form-label">School <span class="required">*</span></label>
          <select name="school" class="form-control form-select" required>
            <option value="">Select school</option>
            <% (typeof schools !== 'undefined' ? schools : []).forEach(sc => { %>
            <option value="<%= sc._id %>"><%= sc.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Type <span class="required">*</span></label>
          <select name="type" class="form-control form-select" required>
            <option value="full">Full Scholarship</option>
            <option value="merit">Merit-Based</option>
            <option value="partial">Partial</option>
            <option value="stem">STEM</option>
            <option value="boarding">Boarding</option>
            <option value="arts">Arts</option>
          </select>
        </div>
        <div class="form-group"><label class="form-label">Coverage % <span class="required">*</span></label><input type="number" name="coveragePercentage" class="form-control" required min="1" max="100" placeholder="100"/></div>
        <div class="form-group"><label class="form-label">Annual Value (USD) <span class="required">*</span></label><input type="number" name="annualValue" class="form-control" required placeholder="78000"/></div>
        <div class="form-group"><label class="form-label">Remaining Tuition (USD)</label><input type="number" name="remainingTuition" class="form-control" placeholder="0"/></div>
        <div class="form-group"><label class="form-label">Enrollment Deposit (USD)</label><input type="number" name="enrollmentDeposit" class="form-control" value="500"/></div>
        <div class="form-group"><label class="form-label">Application Deadline <span class="required">*</span></label><input type="date" name="applicationDeadline" class="form-control" required/></div>
        <div class="form-group"><label class="form-label">Slots Available</label><input type="number" name="slotsTotal" class="form-control" placeholder="20"/></div>
        <div class="form-group"><label class="form-label">Min GPA</label><input type="number" name="eligibility[minGpa]" class="form-control" step="0.1" min="0" max="4" placeholder="3.5"/></div>
        <div class="form-group" style="grid-column:1/-1;"><label class="form-label">Description <span class="required">*</span></label><textarea name="description" class="form-control form-textarea" required rows="3" placeholder="Scholarship overview..."></textarea></div>
        <div style="display:flex;align-items:center;gap:1rem;grid-column:1/-1;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[fullTuition]" value="true" style="accent-color:var(--color-gold);"/> Full Tuition</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[boarding]" value="true" style="accent-color:var(--color-gold);"/> Boarding</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[meals]" value="true" style="accent-color:var(--color-gold);"/> Meals</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[satPrep]" value="true" style="accent-color:var(--color-gold);"/> SAT Prep</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[stemMentorship]" value="true" style="accent-color:var(--color-gold);"/> STEM Mentorship</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="benefits[collegeGuidance]" value="true" style="accent-color:var(--color-gold);"/> College Guidance</label>
          <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;font-size:0.875rem;"><input type="checkbox" name="featured" value="true" style="accent-color:var(--color-gold);"/> Featured</label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" data-close-modal="add-scholarship-modal" class="btn btn-ghost">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="fa-solid fa-plus"></i> Create Scholarship</button>
      </div>
    </form>
  </div>
</div>

<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}</style>
<script src="/js/main.js"></script>
</body></html>
