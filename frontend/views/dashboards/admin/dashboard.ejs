<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Admin Dashboard | ScholarsGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,400&family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">

    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;color:#4a4a6a;">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar">Analytics Dashboard</div>
          <div class="breadcrumb"><span>Admin</span><span class="breadcrumb-sep">/</span><span>Overview</span></div>
        </div>
      </div>
      <div class="topbar-right">
        <span style="font-size:0.75rem;color:var(--color-text-muted);letter-spacing:0.05em;">
          <i class="fa-solid fa-circle" style="color:#2a8a3a;font-size:0.5rem;margin-right:4px;"></i>Live
        </span>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#1a2448,#2a3a68);display:flex;align-items:center;justify-content:center;font-weight:700;color:#c9a84c;font-size:0.875rem;">
            <%= (user.firstName||'A')[0] %>
          </div>
          <span style="font-size:0.875rem;font-weight:600;color:#1a1a2e;"><%= user.firstName %></span>
        </div>
      </div>
    </div>

    <%- include('../../partials/flash') %>

    <div class="dashboard-content">

      <!-- Welcome -->
      <div class="welcome-banner" style="margin-bottom:1.5rem;">
        <div>
          <div class="welcome-title">Platform Overview</div>
          <div class="welcome-subtitle">Real-time statistics for ScholarsGate platform.</div>
        </div>
        <div style="display:flex;gap:0.75rem;">
          <a href="/admin/applications" class="btn btn-gold btn-sm">
            <i class="fa-solid fa-file-lines"></i> All Applications
          </a>
          <a href="/admin/payments" class="btn btn-outline-gold btn-sm">
            <i class="fa-solid fa-circle-check"></i> Verify Payments
            <% if (analytics.pendingPayments > 0) { %>
              <span style="background:#c0392b;color:#fff;border-radius:9999px;padding:1px 7px;font-size:10px;font-weight:700;margin-left:4px;"><%= analytics.pendingPayments %></span>
            <% } %>
          </a>
        </div>
      </div>

      <!-- Stats Row -->
      <div class="stats-row" style="grid-template-columns:repeat(6,1fr);margin-bottom:1.5rem;">
        <div class="stat-card">
          <div class="stat-icon gold"><i class="fa-solid fa-users" style="font-size:1.2rem;color:var(--color-gold-dim);"></i></div>
          <div>
            <div class="stat-value" data-count="<%= analytics.totalGuardians %>">0</div>
            <div class="stat-label">Guardians</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon navy"><i class="fa-solid fa-user-graduate" style="font-size:1.2rem;color:#1a2448;"></i></div>
          <div>
            <div class="stat-value" data-count="<%= analytics.totalStudents %>">0</div>
            <div class="stat-label">Students</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon info"><i class="fa-solid fa-file-lines" style="font-size:1.2rem;color:#1a3a6a;"></i></div>
          <div>
            <div class="stat-value" data-count="<%= analytics.totalApplications %>">0</div>
            <div class="stat-label">Applications</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon gold"><i class="fa-solid fa-school" style="font-size:1.2rem;color:var(--color-gold-dim);"></i></div>
          <div>
            <div class="stat-value" data-count="<%= analytics.totalSchools %>">0</div>
            <div class="stat-label">Schools</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon success"><i class="fa-solid fa-star" style="font-size:1.2rem;color:var(--color-success-light);"></i></div>
          <div>
            <div class="stat-value" data-count="<%= analytics.totalScholarships %>">0</div>
            <div class="stat-label">Scholarships</div>
          </div>
        </div>
        <div class="stat-card" style="<%= analytics.pendingPayments > 0 ? 'border-color:rgba(201,168,76,0.3);' : '' %>">
          <div class="stat-icon" style="background:var(--color-warning-bg);"><i class="fa-solid fa-clock" style="font-size:1.2rem;color:var(--color-warning);"></i></div>
          <div>
            <div class="stat-value" style="<%= analytics.pendingPayments > 0 ? 'color:var(--color-warning);' : '' %>"><%= analytics.pendingPayments %></div>
            <div class="stat-label">Pending Payments</div>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;margin-bottom:1.5rem;">

        <!-- Recent Applications Table -->
        <div class="data-table-wrap">
          <div class="data-table-header">
            <h3>Recent Applications</h3>
            <a href="/admin/applications" class="btn btn-ghost btn-sm">View All</a>
          </div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Student</th>
                <th>School</th>
                <th>Status</th>
                <th>Date</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% recentApplications.forEach(app => { %>
              <tr>
                <td>
                  <div class="user-cell">
                    <div class="table-avatar"><%= (app.student?.firstName||'?')[0] %></div>
                    <div>
                      <div class="table-name"><%= app.student?.firstName %> <%= app.student?.lastName %></div>
                      <div class="table-sub">#<%= app.applicationNumber %></div>
                    </div>
                  </div>
                </td>
                <td style="font-size:0.8rem;max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= app.school?.name %></td>
                <td><span class="badge status-<%= app.status %>" style="font-size:10px;"><%= app.status.replace(/_/g,' ') %></span></td>
                <td style="font-size:0.75rem;color:var(--color-text-muted);"><%= app.submittedAt ? new Date(app.submittedAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) : '—' %></td>
                <td><a href="/admin/applications/<%= app._id %>" class="btn btn-ghost btn-sm" style="font-size:0.7rem;padding:0.25rem 0.75rem;">Review</a></td>
              </tr>
              <% }) %>
              <% if (recentApplications.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--color-text-muted);">No applications yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Application Status Distribution -->
        <div class="chart-card">
          <div class="chart-header">
            <h3 class="chart-title">Status Breakdown</h3>
          </div>
          <% const statusLabels = { draft:'Draft', submitted:'Submitted', under_review:'Under Review', shortlisted:'Shortlisted', accepted:'Accepted', rejected:'Rejected', waitlisted:'Waitlisted' }; %>
          <div style="display:flex;flex-direction:column;gap:0.75rem;">
            <% const statusColors = { draft:'#ccc', submitted:'#1a3a6a', under_review:'#8a6000', shortlisted:'#6432b4', accepted:'#1a6b2a', rejected:'#c0392b', waitlisted:'#c9a84c' }; %>
            <% Object.entries(analytics.statusMap||{}).forEach(([status, count]) => { %>
            <div>
              <div style="display:flex;justify-content:space-between;margin-bottom:4px;">
                <span style="font-size:0.75rem;font-weight:600;color:var(--color-text-secondary)"><%= statusLabels[status]||status %></span>
                <span style="font-size:0.75rem;font-weight:700;color:var(--color-text-primary)"><%= count %></span>
              </div>
              <div class="progress-bar">
                <div class="progress-fill" style="width:<%= analytics.totalApplications > 0 ? Math.round((count/analytics.totalApplications)*100) : 0 %>%;background:<%= statusColors[status]||'#ccc' %>;"></div>
              </div>
            </div>
            <% }) %>
            <% if (!analytics.statusMap || Object.keys(analytics.statusMap).length === 0) { %>
            <p style="text-align:center;color:var(--color-text-muted);font-size:0.875rem;padding:1rem 0;">No data yet.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;">
        <% const quickActions = [
          {icon:'fa-school',label:'Add School',sub:'Add new partner school',href:'/admin/schools/add',color:'gold'},
          {icon:'fa-star',label:'Add Scholarship',sub:'Create new scholarship',href:'/admin/scholarships',color:'info'},
          {icon:'fa-circle-check',label:'Verify Payments',sub:`${analytics.pendingPayments} pending`,href:'/admin/payments',color:'success',urgent: analytics.pendingPayments > 0},
          {icon:'fa-users',label:'Manage Users',sub:'View all users',href:'/admin/users',color:'navy'},
        ]; %>
        <% quickActions.forEach(action => { %>
        <a href="<%= action.href %>" style="display:flex;align-items:center;gap:1rem;padding:1.25rem;background:#fff;border-radius:12px;box-shadow:var(--shadow-sm);border:<%= action.urgent ? '1px solid rgba(201,168,76,0.3)' : 'var(--border-dark)' %>;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-2px)'" onmouseout="this.style.boxShadow='var(--shadow-sm)';this.style.transform=''">
          <div style="width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;background:<%= action.urgent ? 'rgba(201,168,76,0.1)' : 'rgba(0,0,0,0.04)' %>;color:<%= action.urgent ? 'var(--color-gold-dim)' : 'var(--color-text-secondary)' %>;">
            <i class="fa-solid <%= action.icon %>"></i>
          </div>
          <div>
            <div style="font-weight:700;font-size:0.875rem;color:var(--color-text-primary);"><%= action.label %></div>
            <div style="font-size:0.75rem;color:<%= action.urgent ? 'var(--color-warning)' : 'var(--color-text-muted)' %>;"><%= action.sub %></div>
          </div>
        </a>
        <% }) %>
      </div>

    </div>
  </div>
</div>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}</style>
<script src="/js/main.js"></script>
</body></html>
