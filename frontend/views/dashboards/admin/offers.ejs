<!-- offers.ejs placeholder -->
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Offers | Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/style.css"/></head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;"><i class="fa-solid fa-bars"></i></button>
        <div><div class="page-title-bar">Offer Letters</div></div>
      </div>
    </div>
    <div class="dashboard-content">
      <div class="data-table-wrap">
        <div class="data-table-header"><h3>All Offers (<%= offers.length %>)</h3></div>
        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead><tr><th>Offer #</th><th>Student</th><th>School</th><th>Scholarship</th><th>Deposit</th><th>Issued</th><th>Expires</th><th>Status</th></tr></thead>
            <tbody>
              <% offers.forEach(o => { %>
              <tr>
                <td style="font-family:monospace;font-size:0.75rem;">#<%= o.offerNumber %></td>
                <td><div class="user-cell"><div class="table-avatar"><%= (o.student?.firstName||'?')[0] %></div><div><div class="table-name"><%= o.student?.firstName %> <%= o.student?.lastName %></div><div class="table-sub"><%= o.guardian?.email %></div></div></div></td>
                <td style="font-size:0.8rem;"><%= o.school?.name %></td>
                <td style="font-size:0.75rem;color:var(--color-text-muted);"><%= o.scholarship?.name || '—' %> (<%= o.scholarshipDetails?.coveragePercentage||0 %>%)</td>
                <td style="font-weight:700;color:var(--color-gold-dim);">$<%= (o.enrollmentDeposit||500).toLocaleString() %></td>
                <td style="font-size:0.75rem;"><%= new Date(o.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
                <td style="font-size:0.75rem;color:<%= new Date(o.expiryDate)<new Date()?'var(--color-danger-light)':'var(--color-text-muted)' %>;"><%= new Date(o.expiryDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
                <td><span class="badge badge-<%= o.status==='confirmed'?'success':o.status==='accepted'?'info':o.status==='expired'?'danger':'gold' %>"><%= o.status %></span></td>
              </tr>
              <% }) %>
              <% if(offers.length===0){%><tr><td colspan="8" style="text-align:center;padding:3rem;color:var(--color-text-muted);">No offers issued yet.</td></tr><%}%>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;}</style>
<script src="/js/main.js"></script>
</body></html>
