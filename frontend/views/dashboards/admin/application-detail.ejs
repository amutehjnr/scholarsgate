<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Application Detail | Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body data-authenticated>
<div class="dashboard-layout">
  <div class="sidebar-overlay"></div>
  <%- include('../../partials/sidebar') %>
  <div class="dashboard-main">
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.04);border:none;cursor:pointer;color:#4a4a6a;"><i class="fa-solid fa-bars"></i></button>
        <div>
          <div class="page-title-bar">Application #<%= application.applicationNumber %></div>
          <div class="breadcrumb">
            <a href="/admin/applications">Applications</a>
            <span class="breadcrumb-sep">/</span>
            <span><%= application.applicationNumber %></span>
          </div>
        </div>
      </div>
      <div class="topbar-right">
        <span class="badge status-<%= application.status %>" style="font-size:0.8rem;padding:0.4rem 1rem;"><%= application.status.replace(/_/g,' ') %></span>
      </div>
    </div>
    <%- include('../../partials/flash') %>

    <div class="dashboard-content">
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;">

        <!-- Left Column -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Student Info -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.25rem;">Student Information</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
              <% const fields = [
                ['Full Name', `${application.student?.firstName} ${application.student?.lastName}`],
                ['Nationality', application.student?.nationality],
                ['Date of Birth', application.student?.dateOfBirth ? new Date(application.student.dateOfBirth).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'}) : '—'],
                ['Gender', application.student?.gender],
                ['Current School', application.student?.currentSchool || '—'],
                ['Current Grade', application.student?.currentGrade || '—'],
                ['GPA', application.student?.gpa ? `${application.student.gpa} / 4.0` : '—'],
                ['Intended Grade', application.student?.intendedGrade || '—'],
                ['English Test', application.student?.englishProficiency?.test ? `${application.student.englishProficiency.test} — ${application.student.englishProficiency.score}` : '—'],
                ['SAT Score', application.student?.satScore?.total ? `${application.student.satScore.total}/1600` : '—'],
              ]; %>
              <% fields.forEach(([label, value]) => { %>
              <div>
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;"><%= label %></div>
                <div style="font-size:0.875rem;font-weight:600;color:var(--color-text-primary);"><%= value || '—' %></div>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- School & Scholarship -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.25rem;">School & Scholarship</h3>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
              <div>
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">School</div>
                <div style="font-weight:600;color:var(--color-text-primary);"><%= application.school?.name %></div>
                <div style="font-size:0.75rem;color:var(--color-text-muted);"><%= application.school?.location?.city %>, <%= application.school?.location?.state %></div>
              </div>
              <% if (application.scholarship) { %>
              <div>
                <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:3px;">Scholarship</div>
                <div style="font-weight:600;color:var(--color-text-primary);"><%= application.scholarship.name %></div>
                <div style="font-size:0.75rem;color:var(--color-gold-dim);">
                  <%= application.scholarship.coveragePercentage %>% coverage · $<%= (application.scholarship.annualValue||0).toLocaleString() %>/yr
                </div>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Essays -->
          <% if (application.personalStatement || application.whyThisSchool) { %>
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.25rem;">Application Essays</h3>
            <% if (application.whyThisSchool) { %>
            <div style="margin-bottom:1.25rem;">
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Why This School?</div>
              <p style="font-size:0.875rem;color:var(--color-text-secondary);line-height:1.8;background:rgba(0,0,0,0.02);padding:1rem;border-radius:8px;border-left:3px solid var(--color-gold);"><%= application.whyThisSchool %></p>
            </div>
            <% } %>
            <% if (application.personalStatement) { %>
            <div>
              <div style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted);margin-bottom:0.5rem;">Personal Statement</div>
              <p style="font-size:0.875rem;color:var(--color-text-secondary);line-height:1.8;background:rgba(0,0,0,0.02);padding:1rem;border-radius:8px;border-left:3px solid rgba(201,168,76,0.4);"><%= application.personalStatement %></p>
            </div>
            <% } %>
          </div>
          <% } %>

          <!-- Documents -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.25rem;">Submitted Documents</h3>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.75rem;">
              <% const docTypes = [
                {key:'transcript',label:'Transcript',icon:'fa-file-lines'},
                {key:'passport',label:'Passport',icon:'fa-passport'},
                {key:'englishTest',label:'English Test',icon:'fa-language'},
                {key:'recommendationLetter',label:'Recommendation',icon:'fa-file-signature'},
                {key:'personalStatement',label:'Personal Statement',icon:'fa-pen-to-square'},
                {key:'photo',label:'Photo',icon:'fa-image'},
              ]; %>
              <% docTypes.forEach(doc => { %>
              <div style="padding:1rem;border-radius:10px;border:var(--border-dark);text-align:center;background:<%= application.documents?.[doc.key]?.url ? 'var(--color-success-bg)' : 'rgba(0,0,0,0.02)' %>;">
                <div style="font-size:1.5rem;margin-bottom:0.5rem;color:<%= application.documents?.[doc.key]?.url ? 'var(--color-success-light)' : 'var(--color-text-muted)' %>;"><i class="fa-solid <%= doc.icon %>"></i></div>
                <div style="font-size:0.75rem;font-weight:600;color:var(--color-text-secondary);margin-bottom:0.25rem;"><%= doc.label %></div>
                <% if (application.documents?.[doc.key]?.url) { %>
                <a href="<%= application.documents[doc.key].url %>" target="_blank" style="font-size:0.65rem;color:var(--color-success-light);text-decoration:none;">View File ↗</a>
                <% } else { %>
                <span style="font-size:0.65rem;color:var(--color-text-muted);">Not uploaded</span>
                <% } %>
              </div>
              <% }) %>
            </div>
          </div>

          <!-- Timeline -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.25rem;margin-bottom:1.25rem;">Application Timeline</h3>
            <div class="timeline">
              <% (application.timeline||[]).forEach(event => { %>
              <div class="timeline-item">
                <div class="timeline-date"><%= new Date(event.timestamp).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></div>
                <div style="font-weight:600;color:var(--color-text-primary);font-size:0.875rem;text-transform:capitalize;"><%= event.status.replace(/_/g,' ') %></div>
                <% if (event.note) { %><div style="font-size:0.8rem;color:var(--color-text-muted);margin-top:2px;"><%= event.note %></div><% } %>
              </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Guardian Info -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1rem;">Guardian</h3>
            <div style="display:flex;align-items:center;gap:0.875rem;margin-bottom:1rem;padding:0.875rem;background:rgba(0,0,0,0.02);border-radius:10px;">
              <div class="table-avatar" style="width:44px;height:44px;font-size:1rem;"><%= (application.guardian?.firstName||'?')[0] %></div>
              <div>
                <div style="font-weight:700;color:var(--color-text-primary);"><%= application.guardian?.firstName %> <%= application.guardian?.lastName %></div>
                <div style="font-size:0.75rem;color:var(--color-text-muted);"><%= application.guardian?.email %></div>
                <div style="font-size:0.75rem;color:var(--color-text-muted);"><%= application.guardian?.country %></div>
              </div>
            </div>
          </div>

          <!-- Status Update -->
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:1rem;">Update Status</h3>
            <div style="display:flex;flex-direction:column;gap:0.75rem;">
              <div class="form-group" style="margin-bottom:0.5rem;">
                <label class="form-label">New Status</label>
                <select id="new-status" class="form-control form-select">
                  <% ['under_review','shortlisted','interview_scheduled','interview_done','accepted','rejected','waitlisted'].forEach(s => { %>
                  <option value="<%= s %>" <%= application.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ').replace(/\b\w/g,l=>l.toUpperCase()) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group" style="margin-bottom:0.75rem;">
                <label class="form-label">Internal Note</label>
                <textarea data-note-field class="form-control form-textarea" placeholder="Add a note..." rows="2" style="min-height:70px;"></textarea>
              </div>
              <button class="btn btn-gold w-full" id="updateStatusBtn"
                data-status-update
                data-url="/admin/applications/<%= application._id %>/status"
                data-status="">
                <i class="fa-solid fa-check"></i> Update Status
              </button>
            </div>
          </div>

          <!-- Issue Offer (if accepted) -->
          <% if (['shortlisted','interview_done','accepted'].includes(application.status) && !offer) { %>
          <div style="display:flex;flex-direction:column;gap:0.75rem;" id="issue-offer-form">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Enrollment Year</label>
              <input type="text" name="enrollmentYear" value="Fall <%= new Date().getFullYear() + 1 %>" class="form-control"/>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Start Date</label>
              <input type="date" name="startDate" class="form-control"/>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Notes</label>
              <textarea name="notes" class="form-control" rows="2" style="min-height:60px;" placeholder="Optional notes for the family..."></textarea>
            </div>
            <button class="btn btn-gold w-full" data-issue-offer data-url="/admin/applications/<%= application._id %>/offer">
              <i class="fa-solid fa-envelope-open-text"></i> Issue Offer Letter
            </button>
          </div>
          <% } %>

          <!-- Existing Offer -->
          <% if (offer) { %>
          <div class="data-table-wrap" style="padding:1.5rem;border:1px solid rgba(26,107,42,0.2);">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:0.75rem;color:var(--color-success-light);">
              <i class="fa-solid fa-envelope-open-text" style="margin-right:6px;"></i> Offer Issued
            </h3>
            <div style="font-size:0.8rem;color:var(--color-text-secondary);margin-bottom:0.5rem;">Offer #<%= offer.offerNumber %></div>
            <span class="badge badge-<%= offer.status === 'confirmed' ? 'success' : offer.status === 'accepted' ? 'info' : 'gold' %>"><%= offer.status %></span>
            <% if (offer.pdfUrl) { %>
            <a href="<%= offer.pdfUrl %>" target="_blank" class="btn btn-ghost btn-sm w-full" style="margin-top:1rem;">
              <i class="fa-solid fa-file-pdf"></i> Download PDF
            </a>
            <% } %>
          </div>
          <% } %>

          <!-- Payment Info -->
          <% if (payment) { %>
          <div class="data-table-wrap" style="padding:1.5rem;">
            <h3 style="font-family:'Playfair Display',serif;font-size:1.1rem;margin-bottom:0.75rem;">Payment Proof</h3>
            <span class="badge badge-<%= payment.status === 'verified' ? 'success' : payment.status === 'rejected' ? 'danger' : 'warning' %>"><%= payment.status %></span>
            <div style="margin-top:0.75rem;font-size:0.8rem;color:var(--color-text-secondary);">
              $<%= (payment.amount||0).toLocaleString() %> via <%= payment.paymentMethod?.replace(/_/g,' ') || '—' %>
            </div>
            <% if (payment.proofOfPayment?.url) { %>
            <a href="<%= payment.proofOfPayment.url %>" target="_blank" class="btn btn-ghost btn-sm w-full" style="margin-top:0.75rem;">
              <i class="fa-solid fa-image"></i> View Proof
            </a>
            <% } %>
            <% if (payment.status === 'pending') { %>
            <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
              <button class="btn btn-gold btn-sm" style="flex:1;" data-verify-payment data-url="/admin/payments/<%= payment._id %>/verify" data-action="verify">
                <i class="fa-solid fa-check"></i> Verify
              </button>
              <button class="btn btn-danger btn-sm" style="flex:1;" data-verify-payment data-url="/admin/payments/<%= payment._id %>/verify" data-action="reject">
                <i class="fa-solid fa-xmark"></i> Reject
              </button>
            </div>
            <% } %>
          </div>
          <% } %>

        </div>
      </div>
    </div>
  </div>
</div>
<div id="toast-container"></div>
<style>#toast-container{position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:.75rem;}.toast{display:flex;align-items:center;gap:.75rem;padding:.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.2);font-size:.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform .4s cubic-bezier(.34,1.56,.64,1),opacity .4s ease;opacity:0;color:#1a1a2e;}.toast.show{transform:translateX(0);opacity:1;}</style>
<script src="/js/main.js"></script>
<script>
  // ── Status Update ─────────────────────────────────────
  const statusSelect = document.getElementById('new-status');
  const statusBtn    = document.getElementById('updateStatusBtn');

  function syncStatus() {
    if (statusBtn && statusSelect) statusBtn.dataset.status = statusSelect.value;
  }
  syncStatus();
  statusSelect?.addEventListener('change', syncStatus);
  statusBtn?.addEventListener('mousedown', syncStatus);

  // ── Issue Offer ───────────────────────────────────────
  document.getElementById('issueOfferBtn')?.addEventListener('click', async function () {
    const btn = this;
    const enrollmentYear = document.getElementById('offerEnrollmentYear')?.value?.trim();
    const startDate      = document.getElementById('offerStartDate')?.value?.trim();
    const notes          = document.getElementById('offerNotes')?.value?.trim();

    if (!enrollmentYear) {
      showToast('Please enter an enrollment year.', 'error');
      return;
    }

    if (!confirm('Issue offer letter for this application?')) return;

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span> Issuing...';

    try {
      const res = await fetch('/admin/applications/<%= application._id %>/offer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enrollmentYear, startDate, notes }),
      });
      const result = await res.json();
      if (result.success) {
        showToast('Offer letter issued successfully!', 'success');
        setTimeout(() => location.reload(), 1500);
      } else {
        showToast(result.error || 'Failed to issue offer.', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-envelope-open-text"></i> Issue Offer Letter';
      }
    } catch (err) {
      showToast('Network error. Please try again.', 'error');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-envelope-open-text"></i> Issue Offer Letter';
    }
  });
</script>
</body></html>
