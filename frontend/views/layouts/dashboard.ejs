<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | ScholarsGate Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Playfair+Display:wght@0,400;0,700;0,900&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
</head>
<body data-authenticated>

<div class="dashboard-layout">

  <!-- Sidebar Overlay (mobile) -->
  <div class="sidebar-overlay"></div>

  <!-- ─── Sidebar ─── -->
  <aside class="dashboard-sidebar" id="dashboard-sidebar">
    <div class="sidebar-header">
      <a href="/" class="sidebar-logo">
        <div class="sidebar-logo-mark">S</div>
        <span class="sidebar-logo-text">ScholarsGate</span>
      </a>
    </div>

    <nav class="sidebar-nav">
      <% if (user && (user.role === 'guardian' || user.userType === 'guardian')) { %>

        <span class="sidebar-section-label">Main</span>

        <a href="/parent/dashboard" class="sidebar-nav-item <%= currentPath === '/parent/dashboard' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-house"></i></span>
          Dashboard
        </a>

        <a href="/parent/students" class="sidebar-nav-item <%= currentPath.startsWith('/parent/students') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-user-graduate"></i></span>
          My Students
        </a>

        <a href="/parent/applications" class="sidebar-nav-item <%= currentPath.startsWith('/parent/applications') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-file-lines"></i></span>
          Applications
        </a>

        <a href="/parent/offers" class="sidebar-nav-item <%= currentPath.startsWith('/parent/offers') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
          Offer Letters
        </a>

        <span class="sidebar-section-label">Explore</span>

        <a href="/scholarships" class="sidebar-nav-item">
          <span class="nav-icon"><i class="fa-solid fa-star"></i></span>
          Scholarships
        </a>

        <a href="/schools" class="sidebar-nav-item">
          <span class="nav-icon"><i class="fa-solid fa-school"></i></span>
          Schools
        </a>

        <span class="sidebar-section-label">Account</span>

        <a href="/parent/notifications" class="sidebar-nav-item <%= currentPath === '/parent/notifications' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-bell"></i></span>
          Notifications
          <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %>
            <span class="nav-badge"><%= unreadNotifs %></span>
          <% } %>
        </a>

        <a href="/parent/settings" class="sidebar-nav-item <%= currentPath === '/parent/settings' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-gear"></i></span>
          Settings
        </a>

      <% } else { %>
        <!-- Admin nav -->
        <span class="sidebar-section-label">Overview</span>

        <a href="/admin/dashboard" class="sidebar-nav-item <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-chart-line"></i></span>
          Analytics
        </a>

        <span class="sidebar-section-label">Applications</span>

        <a href="/admin/applications" class="sidebar-nav-item <%= currentPath.startsWith('/admin/applications') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-file-lines"></i></span>
          Applications
        </a>

        <a href="/admin/offers" class="sidebar-nav-item <%= currentPath.startsWith('/admin/offers') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
          Offers
        </a>

        <a href="/admin/payments" class="sidebar-nav-item <%= currentPath.startsWith('/admin/payments') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-circle-check"></i></span>
          Payments
        </a>

        <span class="sidebar-section-label">Manage</span>

        <a href="/admin/schools" class="sidebar-nav-item <%= currentPath.startsWith('/admin/schools') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-school"></i></span>
          Schools
        </a>

        <a href="/admin/scholarships" class="sidebar-nav-item <%= currentPath.startsWith('/admin/scholarships') ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-star"></i></span>
          Scholarships
        </a>

        <% if (user && user.role === 'platform_admin') { %>
        <a href="/admin/users" class="sidebar-nav-item <%= currentPath === '/admin/users' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
          Users
        </a>

        <a href="/admin/audit-logs" class="sidebar-nav-item <%= currentPath === '/admin/audit-logs' ? 'active' : '' %>">
          <span class="nav-icon"><i class="fa-solid fa-list-check"></i></span>
          Audit Logs
        </a>
        <% } %>
      <% } %>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="sidebar-avatar">
          <% if (user && user.avatar) { %>
            <img src="<%= user.avatar %>" alt="Avatar" />
          <% } else { %>
            <%= user ? (user.firstName || 'U')[0].toUpperCase() : 'U' %>
          <% } %>
        </div>
        <div class="sidebar-user-info">
          <div class="user-name"><%= user ? `${user.firstName} ${user.lastName}` : 'User' %></div>
          <div class="user-role"><%= user ? (user.role || 'guardian') : '' %></div>
        </div>
      </div>

      <a href="/auth/logout" onclick="event.preventDefault(); document.getElementById('logout-form').submit();"
         class="sidebar-nav-item" style="margin-top: 8px;">
        <span class="nav-icon"><i class="fa-solid fa-right-from-bracket"></i></span>
        Sign Out
      </a>
      <form id="logout-form" action="/auth/logout" method="POST" style="display:none;"></form>
    </div>
  </aside>

  <!-- ─── Main ─── -->
  <div class="dashboard-main">

    <!-- Topbar -->
    <div class="dashboard-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle btn-icon" aria-label="Toggle sidebar">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div>
          <div class="page-title-bar"><%= title %></div>
          <% if (typeof breadcrumb !== 'undefined') { %>
          <div class="breadcrumb">
            <% breadcrumb.forEach((crumb, i) => { %>
              <% if (i > 0) { %><span class="breadcrumb-sep">/</span><% } %>
              <% if (crumb.url) { %><a href="<%= crumb.url %>"><%= crumb.label %></a><% } else { %><span><%= crumb.label %></span><% } %>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
      <div class="topbar-right">
        <a href="/parent/notifications" class="notif-btn">
          <i class="fa-solid fa-bell"></i>
          <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %>
            <span class="notif-dot"></span>
          <% } %>
        </a>
        <div style="display:flex;align-items:center;gap:0.5rem;">
          <div class="sidebar-avatar" style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#c9a84c,#e8c96a);display:flex;align-items:center;justify-content:center;font-weight:700;color:#0a0e1a;font-size:0.875rem;">
            <%= user ? (user.firstName || 'U')[0].toUpperCase() : 'U' %>
          </div>
          <span style="font-size:0.875rem;font-weight:600;color:#1a1a2e;"><%= user ? user.firstName : '' %></span>
        </div>
      </div>
    </div>

    <!-- Flash -->
    <%- include('../partials/flash') %>

    <!-- Page Content -->
    <div class="dashboard-content">
      <%- body %>
    </div>

  </div>
</div>

<div id="toast-container"></div>
<style>
  #toast-container { position:fixed;bottom:2rem;right:2rem;z-index:9999;display:flex;flex-direction:column;gap:0.75rem; }
  .toast { display:flex;align-items:center;gap:0.75rem;padding:0.875rem 1.25rem;border-radius:10px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,0.2);font-size:0.875rem;font-weight:500;min-width:280px;max-width:400px;transform:translateX(120%);transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1),opacity 0.4s ease;opacity:0;color:#1a1a2e; }
  .toast.show{transform:translateX(0);opacity:1;}
  .toast-icon{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:700;flex-shrink:0;}
  .toast-success .toast-icon{background:#e8f5ea;color:#1a6b2a;} .toast-error .toast-icon{background:#ffeaea;color:#c0392b;} .toast-info .toast-icon{background:#e8f0ff;color:#1a3a6a;}
  .toast-success{border-left:3px solid #2a8a3a;} .toast-error{border-left:3px solid #c0392b;} .toast-info{border-left:3px solid #1a3a6a;}
</style>
<script src="/js/main.js"></script>
</body>
</html>
