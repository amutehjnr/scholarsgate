<aside class="dashboard-sidebar" id="dashboard-sidebar">
  <div class="sidebar-header">
    <a href="/" class="sidebar-logo">
      <div class="sidebar-logo-mark">S</div>
      <span class="sidebar-logo-text">ScholarsGate</span>
    </a>
  </div>

  <nav class="sidebar-nav">
    <% if (user && (user.role === 'guardian' || user.userType === 'guardian')) { %>

      <span class="sidebar-section-label">Main</span>
      <a href="/parent/dashboard" class="sidebar-nav-item <%= currentPath === '/parent/dashboard' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-house"></i></span>Dashboard
      </a>
      <a href="/parent/students" class="sidebar-nav-item <%= currentPath.startsWith('/parent/students') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-user-graduate"></i></span>My Students
      </a>
      <a href="/parent/applications" class="sidebar-nav-item <%= currentPath.startsWith('/parent/applications') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-file-lines"></i></span>Applications
      </a>
      <a href="/parent/offers" class="sidebar-nav-item <%= currentPath.startsWith('/parent/offers') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-envelope-open-text"></i></span>Offer Letters
      </a>

      <span class="sidebar-section-label">Explore</span>
      <a href="/scholarships" class="sidebar-nav-item">
        <span class="nav-icon"><i class="fa-solid fa-star"></i></span>Scholarships
      </a>
      <a href="/schools" class="sidebar-nav-item">
        <span class="nav-icon"><i class="fa-solid fa-school"></i></span>Schools
      </a>

      <span class="sidebar-section-label">Account</span>
      <a href="/parent/notifications" class="sidebar-nav-item <%= currentPath === '/parent/notifications' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-bell"></i></span>Notifications
        <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %>
          <span class="nav-badge"><%= unreadNotifs %></span>
        <% } %>
      </a>
      <a href="/parent/settings" class="sidebar-nav-item <%= currentPath === '/parent/settings' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-gear"></i></span>Settings
      </a>

    <% } else { %>
      <!-- Admin Navigation -->
      <span class="sidebar-section-label">Overview</span>
      <a href="/admin/dashboard" class="sidebar-nav-item <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-chart-line"></i></span>Analytics
      </a>

      <span class="sidebar-section-label">Applications</span>
      <a href="/admin/applications" class="sidebar-nav-item <%= currentPath.startsWith('/admin/applications') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-file-lines"></i></span>Applications
      </a>
      <a href="/admin/offers" class="sidebar-nav-item <%= currentPath.startsWith('/admin/offers') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-envelope-open-text"></i></span>Offers
      </a>
      <a href="/admin/bank-details" class="sidebar-nav-item <%= currentPath === '/admin/bank-details' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-building-columns"></i></span>Bank Details
      </a>
      <a href="/admin/payments" class="sidebar-nav-item <%= currentPath.startsWith('/admin/payments') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-circle-check"></i></span>Payments
      </a>

      <span class="sidebar-section-label">Manage</span>
      <a href="/admin/schools" class="sidebar-nav-item <%= currentPath.startsWith('/admin/schools') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-school"></i></span>Schools
      </a>
      <a href="/admin/scholarships" class="sidebar-nav-item <%= currentPath.startsWith('/admin/scholarships') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-star"></i></span>Scholarships
      </a>

      <span class="sidebar-section-label">Communication</span>
      <a href="/admin/email-campaigns" class="sidebar-nav-item <%= currentPath.startsWith('/admin/email-campaigns') ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-bullhorn"></i></span>Email Campaigns
      </a>

      <% if (user && user.role === 'platform_admin') { %>
      <a href="/admin/users" class="sidebar-nav-item <%= currentPath === '/admin/users' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-users"></i></span>Users
      </a>
      <a href="/admin/audit-logs" class="sidebar-nav-item <%= currentPath === '/admin/audit-logs' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-list-check"></i></span>Audit Logs
      </a>
      <% } %>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="sidebar-avatar">
        <% if (user && user.avatar) { %>
          <img src="<%= user.avatar %>" alt="Avatar"/>
        <% } else { %>
          <%= user ? (user.firstName||'U')[0].toUpperCase() : 'U' %>
        <% } %>
      </div>
      <div class="sidebar-user-info">
        <div class="user-name"><%= user ? `${user.firstName} ${user.lastName}` : 'User' %></div>
        <div class="user-role"><%= user ? (user.role || 'guardian').replace('_',' ') : '' %></div>
      </div>
    </div>
    <form action="/auth/logout" method="POST">
      <button type="submit" class="sidebar-nav-item w-full" style="width:100%;text-align:left;border:none;cursor:pointer;background:none;margin-top:8px;">
        <span class="nav-icon"><i class="fa-solid fa-right-from-bracket"></i></span>Sign Out
      </button>
    </form>
  </div>
</aside>
